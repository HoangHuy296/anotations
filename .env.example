# PostgreSQL
POSTGRES_USER=fieldframe
# Required. Generate a local secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=fieldframe
POSTGRES_PORT=5432

# Used by Prisma when running from your local machine
DATABASE_URL="postgresql://fieldframe:<POSTGRES_PASSWORD>@postgres:5432/fieldframe?schema=public"

# Used by Docker containers if needed
DATABASE_URL_DOCKER="postgresql://fieldframe:<POSTGRES_PASSWORD>@postgres:5432/fieldframe?schema=public"

# Redis / BullMQ
# Internal Compose DNS only. Redis is intentionally not published to the host.
REDIS_HOST=redis
REDIS_PORT=6379
# Required. Generate a local secret with: openssl rand -base64 32
REDIS_PASSWORD=
BULLMQ_PREFIX=annotation-platform

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=annotation-assets
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Public URLs for development
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
