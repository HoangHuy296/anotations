# PostgreSQL
POSTGRES_USER=fieldframe
# Required. Generate a local secret with: openssl rand -hex 32
POSTGRES_PASSWORD=8dded31253ab6a500b97e1948a4cae910cf7f9c088fe9ea9dc75b472fa5df4d5
POSTGRES_DB=fieldframe
POSTGRES_PORT=5432

# Used by Prisma when running from your local machine
DATABASE_URL="postgresql://fieldframe:<POSTGRES_PASSWORD>@postgres:5432/fieldframe?schema=public"

# Used by Docker containers if needed
DATABASE_URL_DOCKER="postgresql://fieldframe:<POSTGRES_PASSWORD>@postgres:5432/fieldframe?schema=public"

# Required before using encrypted SourceConnection provider tokens. Generate: openssl rand -base64 32
SOURCE_CONNECTION_ENCRYPTION_KEY=wSA2xXBH4KiKxAjt9b38M8bqk6QbYzbs0p9AZkUp+4I=

# AIOZ-company AI provider (worker-only; never read by the web app)
# Set once the real AIOZ-company API contract/credentials are available.
# Blocks apps/worker/src/providers/ai/aioz-company.provider.ts until supplied.
AIOZ_COMPANY_API_BASE_URL=
AIOZ_COMPANY_API_KEY=

# Redis / BullMQ
# Compose services use internal DNS. Redis is also published only to 127.0.0.1
# for explicitly opted-in local integration tests; it is never public.
REDIS_HOST=redis
REDIS_PORT=6379
# Required. Generate a local secret with: openssl rand -base64 32
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=annotation-platform

# Host-only full queue integration tests: set these in an untracked local env
# file. REDIS_HOST must be 127.0.0.1, REDIS_PASSWORD must be non-empty, and
# REDIS_DB/BULLMQ_PREFIX must exactly match the test-scoped values below.
# QUEUE_INTEGRATION_TESTS=1
# REDIS_TEST_DB=<non-zero Redis DB index>
# REDIS_TEST_PREFIX=<dedicated test key prefix>

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=annotation-assets
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Public URLs for development
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001

# 021-production-hardening-garbage-collection -- every value below has a
# production-safe default; none of these need to be set to run correctly.

# Rate limiting (web-only). See apps/web/src/lib/config/production-hardening.ts.
RATE_LIMIT_AI_TASK_PER_MINUTE=10
RATE_LIMIT_IMPORT_PER_MINUTE=10
RATE_LIMIT_EXPORT_PER_MINUTE=10

# Pagination (web-only). Hard cap on any caller-requested page size.
PAGINATION_MAX_PAGE_SIZE=100

# Job recovery / stall handling (worker-only). See apps/worker/src/config.ts's
# productionHardeningPolicySchema.
JOB_RECOVERY_LEASE_GRACE_MS=60000
JOB_MAX_RUNTIME_MS=3600000
JOB_LOCK_DURATION_MS=30000
JOB_STALLED_INTERVAL_MS=30000
JOB_MAX_STALLED_COUNT=1

# JobEvent retention cleanup (worker-only).
JOB_EVENT_RETENTION_DAYS=30
JOB_EVENT_CLEANUP_BATCH_SIZE=500

# MinIO orphan-object garbage collection (worker-only).
# MINIO_ORPHAN_SCAN_DRY_RUN must stay "true" here -- never flip it in a
# shared/committed env file. Enable a live sweep only for one deliberate,
# reviewed run, never as a standing default.
MINIO_ORPHAN_GRACE_PERIOD_MS=86400000
MINIO_ORPHAN_SCAN_DRY_RUN=true

# Temporary-upload cleanup (worker-only).
TEMP_UPLOAD_RETENTION_MS=86400000
MINIO_TEMP_UPLOAD_LIFECYCLE_DAYS=7
