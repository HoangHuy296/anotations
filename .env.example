# Annotation Platform: configuration for `docker compose up -d --build` (served at http://<APP_BIND_HOST>:3300).
# Copy to `.env` and replace every CHANGE_ME. Never commit `.env`. Generate secrets with: openssl rand -base64 32

# --- Entry point -------------------------------------------------------------------------------------------------------
# Address the :3300 proxy listens on. 127.0.0.1 = this machine only; 0.0.0.0 (or a LAN address) = reachable from the network.
APP_BIND_HOST=127.0.0.1
MVP_WEB_PORT=3300
REALTIME_HOST_PORT=3304
COOKIE_SECURE=false                  # true only behind HTTPS

# --- PostgreSQL --------------------------------------------------------------------------------------------------------
MVP_POSTGRES_PORT=55475              # host loopback port (the G1 migration tooling expects 55460-55479)
POSTGRES_PASSWORD=CHANGE_ME
# Container-network URL used by web, worker and the migrate step (must use the same password as above).
DATABASE_URL_DOCKER=postgresql://postgres:CHANGE_ME@postgres:5432/fieldframe
# Host-side URL for Prisma/db-safety commands run outside Docker.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:55475/fieldframe

# --- Redis (queue transport only) --------------------------------------------------------------------------------------
MVP_REDIS_PORT=56379
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_DB=0
BULLMQ_PREFIX=annotation-platform-mvp

# --- MinIO -------------------------------------------------------------------------------------------------------------
# Root credentials: used by MinIO itself and the one-shot bucket bootstrap only.
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=annotation-assets
# Least-privilege identities used by the apps; they must already exist on the MinIO volume (an existing volume keeps them; a brand-new MinIO volume needs the one-time S0 provisioning first).
A24_WEB_KEY=CHANGE_ME
A24_WEB_SECRET=CHANGE_ME
A24_WORKER_KEY=CHANGE_ME
A24_WORKER_SECRET=CHANGE_ME
A24_VERIFIER_KEY=CHANGE_ME
A24_VERIFIER_SECRET=CHANGE_ME
# Browser-facing S3 address (presigned uploads/views) and the interface it is published on.
MVP_MINIO_S3_BIND_HOST=127.0.0.1     # a LAN address when the AI service or other machines must fetch images
MVP_MINIO_PORT=59000
MVP_MINIO_CONSOLE_PORT=59001         # console is always loopback-only
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:59000
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:3300

# --- Application secrets -----------------------------------------------------------------------------------------------
REALTIME_TICKET_SECRET=CHANGE_ME
UPLOAD_CAPABILITY_SECRET=CHANGE_ME
SOURCE_CONNECTION_ENCRYPTION_KEY=CHANGE_ME   # base64 of 32 random bytes

# --- Gitea (source repositories, HTTPS) --------------------------------------------------------------------------------
# Server-side address of Gitea inside the Compose network. Users enter this same value as "Gitea server URL" when importing.
GITEA_PUBLIC_URL=https://gitea:3000/
GITEA_INTERNAL_URL=https://gitea:3000
GITEA_DB_PASSWORD=CHANGE_ME
MVP_GITEA_HTTP_PORT=3310             # browser access: https://localhost:3310
MVP_GITEA_SSH_PORT=2232
# Directory holding gitea.crt and gitea.key (self-signed certificate for the `gitea` host name). Kept outside the repository.
MVP_TLS_DIR=/home/CHANGE_ME/.config/annotation-mvp/tls

# --- AI service (optional) ---------------------------------------------------------------------------------------------
AIOZ_ANNOTATION_SERVICES_URL=
AIOZ_COMPANY_API_KEY=
AIOZ_ANNOTATION_SERVICES_TIMEOUT_MS=15000

# --- Tunables (defaults shown; uncomment to override) ------------------------------------------------------------------
# RATE_LIMIT_AI_TASK_PER_MINUTE=10
# RATE_LIMIT_IMPORT_PER_MINUTE=10
# RATE_LIMIT_EXPORT_PER_MINUTE=10
# PAGINATION_MAX_PAGE_SIZE=100
# JOB_MAX_RUNTIME_MS=3600000
# JOB_EVENT_RETENTION_DAYS=30
# MINIO_ORPHAN_SCAN_DRY_RUN=true
# TEXT_WORKSPACE_MAX_SOURCE_BYTES=1048576
