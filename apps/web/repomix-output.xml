  const validationCases = [
    { body: { type: "UNSUPPORTED", startMs: 0, endMs: 100 }, status: 400 },
    { body: { type: "EVENT", startMs: -1, endMs: 100 }, status: 400 },
    { body: { type: "EVENT", startMs: 100, endMs: 100 }, status: 400 },
