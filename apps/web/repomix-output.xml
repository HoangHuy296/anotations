  assert.equal(workspaceListQuerySchema.safeParse({ page: "1", q: "x".repeat(101), statuses: [] }).success, false);
  assert.equal(workspaceListQuerySchema.safeParse({ page: "1", q: "", statuses: ["UNKNOWN"] }).success, false);
