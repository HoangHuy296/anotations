test("adapter validates each redirect destination before following it", async () => {
  const previous = process.env.SOURCE_ALLOWED_IP_CIDRS;
  process.env.SOURCE_ALLOWED_IP_CIDRS = "127.0.0.1/32";
  let requests = 0;
