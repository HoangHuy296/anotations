  try {
    const result = await gitea.client.listRepositories(parsed.data);
    return apiSuccess({
      items: result.repositories,
      pagination: {
        page: parsed.data.page,
        limit: parsed.data.limit,
        totalCount: result.totalCount,
      },
    });
  } catch (error: unknown) {
    return giteaErrorResponse(error);
  }
}
