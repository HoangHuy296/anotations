    expectedRevision: 1,
    startMs: 300,
    endMs: 1_100,
  });
  assert.deepEqual(stale, { ok: false, reason: "CONFLICT" });

  const invalidRange = await updateVideoTemporalLabel(actor, created.value.id, {
    expectedRevision: 2,
    startMs: 4_900,
    endMs: 5_100,
  });
  assert.deepEqual(invalidRange, { ok: false, reason: "INVALID_REQUEST" });

