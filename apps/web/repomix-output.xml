        </span>
        <button
          type="button"
          className="grid size-9 place-items-center rounded-lg text-zinc-400 hover:bg-zinc-800 hover:text-white"
          aria-label="Zoom in"
          onClick={onZoomIn}
        >
          <MagnifyingGlassPlus aria-hidden="true" size={18} />
