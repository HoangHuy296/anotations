// Compose-only hostname. This stays process-local and never writes `.env`.
if (enabled) {
  process.env.MINIO_ENDPOINT = "http://localhost:9000";
  process.env.MINIO_PUBLIC_ENDPOINT = "http://localhost:9000";
}
const port = 3_117;
