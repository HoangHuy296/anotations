    { provider: "GITEA", repository: { owner: "team", name: "images", baseUrl: "https://gitea.example.test" }, queueName: "imports" },
    { provider: "GITHUB", repository: { owner: "team", name: "images", baseUrl: "https://override.example.test" } },
