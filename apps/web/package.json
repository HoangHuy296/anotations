    "lucide-react": "^1.21.0",
    "minio": "^8.0.5",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.6.0",
