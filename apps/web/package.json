    "test:direct-upload": "node ../../scripts/db-safety/cli.mjs test web:test:direct-upload",
    "test:job-queue": "node ../../scripts/db-safety/cli.mjs test web:test:job-queue",
    "test:local-folder-import": "node ../../scripts/db-safety/cli.mjs test web:test:local-folder-import",
    "test:workspace": "node ../../scripts/db-safety/cli.mjs test web:test:workspace",
    "test:source-connections": "node ../../scripts/db-safety/cli.mjs test web:test:source-connections",
    "test:repository-preflight": "node ../../scripts/db-safety/cli.mjs test web:test:repository-preflight",
    "test:repository-import-request": "node ../../scripts/db-safety/cli.mjs test web:test:repository-import-request",
