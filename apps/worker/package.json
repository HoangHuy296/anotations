{
  "name": "@annotationplatform/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:ai-provider": "node ../../scripts/db-safety/cli.mjs test worker:test:ai-provider",
    "test:queue": "node ../../scripts/db-safety/cli.mjs test worker:test:queue",
    "test:import": "node ../../scripts/db-safety/cli.mjs test worker:test:import",
    "test:source-access": "node ../../scripts/db-safety/cli.mjs test worker:test:source-access",
    "test:repository-import": "node ../../scripts/db-safety/cli.mjs test worker:test:repository-import"
  },
  "dependencies": {
    "@annotationplatform/domain": "workspace:*",
    "@annotationplatform/queue": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.79.3",
    "ioredis": "5.10.1",
    "minio": "^8.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
