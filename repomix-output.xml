  "inlineSchema": "generator client {\n  provider = \"prisma-client\"\n  output   = \"../lib/generated/prisma\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nmodel User {\n  id                   String                     @id @default(cuid())\n  email                String                     @unique\n  passwordHash         String?\n  name                 String?\n  role                 UserRole\n  createdAt            DateTime                   @default(now())\n  updatedAt            DateTime                   @updatedAt\n  aiTasksCreated       AiTask[]                   @relation(\"AiTaskCreatedBy\")\n  annotationsCreated   Annotation[]               @relation(\"AnnotationCreatedBy\")\n  annotationsReviewed  Annotation[]               @relation(\"AnnotationReviewedBy\")\n  annotationsUpdated   Annotation[]               @relation(\"AnnotationUpdatedBy\")\n  uploadedAssets       Asset[]                    @relation(\"AssetUploadedBy\")\n  assignedAssets       Asset[]                    @relation(\"AssetAssignedTo\")\n  assetLabelsCreated   AssetLabel[]               @relation(\"AssetLabelCreatedBy\")\n  sessions             AuthSession[]\n  ownedDatasets        Dataset[]                  @relation(\"DatasetOwner\")\n  memberships          DatasetMember[]\n  externalRepositories ExternalRepository[]       @relation(\"ExternalRepositoryCreatedBy\")\n  jobsCanceled         Job[]                      @relation(\"JobCanceledBy\")\n  jobsCreated          Job[]                      @relation(\"JobCreatedBy\")\n  preparedImports      PreparedImport[]           @relation(\"PreparedImportCreatedBy\")\n  sourceConnections    SourceConnection[]         @relation(\"SourceConnectionOwner\")\n  tracksCreated        VideoObjectTrack[]         @relation(\"TrackCreatedBy\")\n  workflowEvents       AssetWorkflowEvent[]       @relation(\"AssetWorkflowActor\")\n  invitationsReceived  DatasetInvitation[]        @relation(\"DatasetInvitationInvitee\")\n  invitationsSent      DatasetInvitation[]        @relation(\"DatasetInvitationInvitedBy\")\n  assignmentSlots      AssetAssignment[]          @relation(\"AssetAssignmentUser\")\n  assignmentsCreated   AssetAssignment[]          @relation(\"AssetAssignmentCreatedBy\")\n  assignmentEvents     AssetAssignmentEvent[]     @relation(\"AssetAssignmentEventActor\")\n  commentsAuthored     AssetComment[]             @relation(\"AssetCommentAuthor\")\n  commentsResolved     AssetComment[]             @relation(\"AssetCommentResolver\")\n  commentMentions      CommentMention[]\n  notifications        Notification[]             @relation(\"NotificationRecipient\")\n  notificationsActed   Notification[]             @relation(\"NotificationActor\")\n  membershipEventsFor  DatasetMembershipEvent[]   @relation(\"DatasetMembershipEventMember\")\n  membershipEventsBy   DatasetMembershipEvent[]   @relation(\"DatasetMembershipEventActor\")\n  outboxEventsActed    CollaborationOutboxEvent[] @relation(\"CollaborationOutboxActor\")\n  outboxEventsFor      CollaborationOutboxEvent[] @relation(\"CollaborationOutboxRecipient\")\n}\n\nmodel AuthSession {\n  id               String    @id @default(cuid())\n  userId           String\n  refreshTokenHash String    @unique\n  userAgent        String?\n  ipAddress        String?\n  expiresAt        DateTime\n  revokedAt        DateTime?\n  createdAt        DateTime  @default(now())\n  updatedAt        DateTime  @updatedAt\n  deletedAt        DateTime?\n  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@index([expiresAt])\n}\n\nmodel Job {\n  id                       String                    @id @default(cuid())\n  datasetId                String\n  createdById              String\n  canceledById             String?\n  type                     JobType\n  modality                 Modality?\n  status                   JobStatus                 @default(QUEUED)\n  stage                    JobStage                  @default(WAITING)\n  queueName                String?\n  queueJobId               String?\n  enqueuedAt               DateTime?\n  dequeuedAt               DateTime?\n  priority                 JobPriority               @default(NORMAL)\n  priorityValue            Int                       @default(50)\n  trigger                  JobTrigger                @default(USER)\n  provider                 RepoProvider?\n  sourceConnectionId       String?\n  externalRepositoryId     String?\n  /// *\n  ///    * Task-specific request payload.\n  ///    * Do not store secrets here.\n  input                    Json                      @default(\"{}\")\n  /// *\n  ///    * Runtime checkpoint.\n  ///    * Worker can update this while running.\n  state                    Json                      @default(\"{}\")\n  /// *\n  ///    * Realtime/final summary for frontend.\n  summary                  Json                      @default(\"{}\")\n  progress                 Int                       @default(0)\n  totalItems               Int?\n  processedItems           Int                       @default(0)\n  successItems             Int                       @default(0)\n  failedItems              Int                       @default(0)\n  skippedItems             Int                       @default(0)\n  error                    String?\n  errorCode                String?\n  errorDetails             Json?\n  /// *\n  ///    * Worker locking.\n  lockedBy                 String?\n  lockToken                String?\n  lockedAt                 DateTime?\n  lockedUntil              DateTime?\n  heartbeatAt              DateTime?\n  startedAt                DateTime?\n  finishedAt               DateTime?\n  runAfter                 DateTime?\n  attempts                 Int                       @default(0)\n  maxAttempts              Int                       @default(3)\n  /// *\n  ///    * Soft cancel.\n  cancelRequestedAt        DateTime?\n  canceledAt               DateTime?\n  /// *\n  ///    * Prevent duplicate jobs.\n  ///    * For clone repo, generate from dataset/repo/ref/rootPath/modality/sourceMode.\n  idempotencyKey           String?\n  /// *\n  ///    * Output result if job creates a file.\n  resultStorageKey         String?\n  resultFilename           String?\n  createdAt                DateTime                  @default(now())\n  updatedAt                DateTime                  @updatedAt\n  retryOfJobId             String?                   @unique\n  aiTasks                  AiTask?\n  canceledBy               User?                     @relation(\"JobCanceledBy\", fields: [canceledById], references: [id])\n  createdBy                User                      @relation(\"JobCreatedBy\", fields: [createdById], references: [id])\n  dataset                  Dataset                   @relation(\"DatasetJobs\", fields: [datasetId], references: [id], onDelete: Cascade)\n  externalRepository       ExternalRepository?       @relation(\"ExternalRepositoryJobs\", fields: [externalRepositoryId], references: [id])\n  retryOfJob               Job?                      @relation(\"JobRetryLineage\", fields: [retryOfJobId], references: [id], onDelete: Restrict)\n  retrySuccessor           Job?                      @relation(\"JobRetryLineage\")\n  sourceConnection         SourceConnection?         @relation(fields: [sourceConnectionId], references: [id])\n  events                   JobEvent[]\n  preparedImport           PreparedImport?\n  collaborationOutboxEvent CollaborationOutboxEvent?\n\n  @@unique([datasetId, idempotencyKey])\n  @@index([datasetId, status])\n  @@index([createdById])\n  @@index([canceledById])\n  @@index([status, runAfter])\n  @@index([status, priorityValue, createdAt])\n  @@index([status, heartbeatAt])\n  @@index([lockedUntil])\n  @@index([sourceConnectionId])\n  @@index([externalRepositoryId])\n  @@index([type, status])\n  @@index([queueName, queueJobId])\n}\n\nmodel JobEvent {\n  id        String        @id @default(cuid())\n  jobId     String\n  level     JobEventLevel @default(INFO)\n  stage     JobStage?\n  message   String\n  data      Json          @default(\"{}\")\n  createdAt DateTime      @default(now())\n  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)\n\n  @@index([jobId])\n  @@index([jobId, createdAt])\n  @@index([level])\n}\n\nmodel ExternalRepository {\n  id             String         @id @default(cuid())\n  provider       RepoProvider\n  visibility     RepoVisibility @default(PUBLIC)\n  /// *\n  ///    * Normalized base URL.\n  ///    * Use empty string for provider default, e.g. github.com / huggingface.co.\n  baseUrl        String         @default(\"\")\n  owner          String?\n  repo           String\n  fullName       String\n  externalRepoId String?\n  repoType       String?\n  defaultBranch  String?\n  description    String?\n  homepageUrl    String?\n  createdById    String?\n  metadata       Json           @default(\"{}\")\n  createdAt      DateTime       @default(now())\n  updatedAt      DateTime       @updatedAt\n  assets         Asset[]\n  assetVersions  AssetVersion[]\n  datasets       Dataset[]\n  createdBy      User?          @relation(\"ExternalRepositoryCreatedBy\", fields: [createdById], references: [id])\n  jobs           Job[]          @relation(\"ExternalRepositoryJobs\")\n\n  @@unique([provider, baseUrl, fullName])\n  @@index([provider])\n  @@index([createdById])\n}\n\nmodel SourceConnection {\n  id                    String                 @id @default(cuid())\n  userId                String\n  provider              RepoProvider\n  authType              RepoAuthType           @default(TOKEN)\n  baseUrl               String                 @default(\"\")\n  name                  String?\n  externalAccountId     String?\n  accountUsername       String?\n  accountEmail          String?\n  tokenEncrypted        String?\n  refreshTokenEncrypted String?\n  tokenExpiresAt        DateTime?\n  scopes                Json                   @default(\"[]\")\n  status                SourceConnectionStatus @default(ACTIVE)\n  revokedAt             DateTime?\n  metadata              Json                   @default(\"{}\")\n  createdAt             DateTime               @default(now())\n  updatedAt             DateTime               @updatedAt\n  datasets              Dataset[]\n  jobs                  Job[]\n  user                  User                   @relation(\"SourceConnectionOwner\", fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, provider, externalAccountId])\n  @@index([userId])\n  @@index([provider])\n  @@index([provider, baseUrl])\n  @@index([status])\n  @@index([tokenExpiresAt])\n}\n\nmodel Dataset {\n  id                     String                     @id @default(cuid())\n  ownerId                String\n  name                   String\n  description            String?\n  type                   DatasetType                @default(MULTI_MODAL)\n  primaryModality        Modality?\n  metadata               Json                       @default(\"{}\")\n  sourceMode             DatasetSourceMode          @default(UPLOAD)\n  externalRepositoryId   String?\n  sourceConnectionId     String?\n  sourceRootPath         String?\n  sourceRef              String?\n  lockedRevision         String?\n  currentRevision        String?\n  creationIdempotencyKey String?\n  creationRequestHash    String?\n  includePatterns        Json                       @default(\"[]\")\n  excludePatterns        Json                       @default(\"[]\")\n  lastSyncedAt           DateTime?\n  syncStatus             AssetSyncStatus            @default(SYNCED)\n  syncSummary            Json                       @default(\"{}\")\n  createdAt              DateTime                   @default(now())\n  updatedAt              DateTime                   @updatedAt\n  archivedAt             DateTime?\n  deletedAt              DateTime?\n  aiTasks                AiTask[]\n  annotations            Annotation[]\n  assets                 Asset[]\n  assetVersions          AssetVersion[]\n  externalRepository     ExternalRepository?        @relation(fields: [externalRepositoryId], references: [id])\n  owner                  User                       @relation(\"DatasetOwner\", fields: [ownerId], references: [id], onDelete: Cascade)\n  sourceConnection       SourceConnection?          @relation(fields: [sourceConnectionId], references: [id])\n  members                DatasetMember[]\n  jobs                   Job[]                      @relation(\"DatasetJobs\")\n  labels                 Label[]\n  preparedImports        PreparedImport[]\n  invitations            DatasetInvitation[]\n  assignmentSlots        AssetAssignment[]\n  assignmentEvents       AssetAssignmentEvent[]\n  comments               AssetComment[]\n  membershipEvents       DatasetMembershipEvent[]\n  notifications          Notification[]\n  outboxEvents           CollaborationOutboxEvent[]\n\n  @@unique([ownerId, creationIdempotencyKey])\n  @@index([ownerId])\n  @@index([ownerId, primaryModality])\n  @@index([type])\n  @@index([primaryModality])\n  @@index([sourceMode])\n  @@index([externalRepositoryId])\n  @@index([sourceConnectionId])\n  @@index([currentRevision])\n}\n\n/// *\n///  * Durable browser-to-MinIO import preparation. It stores only bounded metadata\n///  * and private object references; no binary, browser handle, or local path is\n///  * ever persisted.\nmodel PreparedImport {\n  id                String               @id @default(cuid())\n  datasetId         String\n  jobId             String               @unique\n  createdById       String\n  status            PreparedImportStatus @default(PREPARING)\n  expectedItemCount Int\n  deadlineAt        DateTime\n  committedAt       DateTime?\n  idempotencyKey    String\n  createdAt         DateTime             @default(now())\n  updatedAt         DateTime             @updatedAt\n  createdBy         User                 @relation(\"PreparedImportCreatedBy\", fields: [createdById], references: [id])\n  dataset           Dataset              @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  job               Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)\n  items             PreparedImportItem[]\n\n  @@unique([createdById, idempotencyKey])\n  @@index([datasetId, createdAt])\n  @@index([status, deadlineAt])\n  @@index([createdById, createdAt])\n}\n\nmodel PreparedImportItem {\n  id               String         @id @default(cuid())\n  preparedImportId String\n  logicalPath      String\n  normalizedPath   String\n  filename         String\n  mimeType         String\n  sizeBytes        BigInt\n  modality         Modality\n  position         Int\n  fingerprint      String\n  storageKey       String         @unique\n  assetId          String?        @unique\n  completedAt      DateTime?\n  createdAt        DateTime       @default(now())\n  updatedAt        DateTime       @updatedAt\n  asset            Asset?         @relation(fields: [assetId], references: [id])\n  preparedImport   PreparedImport @relation(fields: [preparedImportId], references: [id], onDelete: Cascade)\n\n  @@unique([preparedImportId, normalizedPath])\n  @@unique([preparedImportId, position])\n  @@index([preparedImportId, completedAt])\n  @@index([assetId])\n}\n\nmodel DatasetMember {\n  id        String            @id @default(cuid())\n  datasetId String\n  userId    String\n  role      DatasetMemberRole @default(LABELER)\n  createdAt DateTime          @default(now())\n  updatedAt DateTime          @updatedAt\n  dataset   Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([datasetId, userId])\n  @@index([userId])\n  @@index([datasetId])\n  @@index([datasetId, role])\n}\n\n/// Durable, existing-user invitation. A pending invitation is not a\n/// DatasetMember and therefore never grants access before acceptance.\nmodel DatasetInvitation {\n  id            String                  @id @default(cuid())\n  datasetId     String\n  inviteeUserId String\n  invitedById   String\n  role          DatasetMemberRole\n  status        DatasetInvitationStatus @default(PENDING)\n  /// `PENDING` while active and null after a terminal state. PostgreSQL allows\n  /// multiple nulls, making this portable Prisma uniqueness enforcement.\n  activeKey     String?\n  expiresAt     DateTime\n  respondedAt   DateTime?\n  revokedAt     DateTime?\n  createdAt     DateTime                @default(now())\n  updatedAt     DateTime                @updatedAt\n  dataset       Dataset                 @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  invitee       User                    @relation(\"DatasetInvitationInvitee\", fields: [inviteeUserId], references: [id], onDelete: Cascade)\n  invitedBy     User                    @relation(\"DatasetInvitationInvitedBy\", fields: [invitedById], references: [id], onDelete: Restrict)\n\n  @@unique([datasetId, inviteeUserId, activeKey])\n  @@index([inviteeUserId, status, createdAt])\n  @@index([datasetId, status, createdAt])\n  @@index([expiresAt])\n}\n\nmodel Asset {\n  id                   String                     @id @default(cuid())\n  datasetId            String\n  uploadedById         String?\n  assignedToId         String?\n  modality             Modality\n  filename             String\n  originalFilename     String?\n  mimeType             String\n  sizeBytes            BigInt?\n  width                Int?\n  height               Int?\n  durationMs           Int?\n  textLength           Int?\n  sourceMode           DatasetSourceMode          @default(UPLOAD)\n  storageProvider      StorageProvider?\n  storageBucket        String?\n  storageKey           String?\n  checksum             String?\n  externalRepositoryId String?\n  sourceProvider       RepoProvider?\n  sourceRef            String?\n  sourceRevision       String?\n  sourcePath           String?\n  sourceFileSha        String?\n  sourceBlobSha        String?\n  sourceLfsOid         String?\n  sourceEtag           String?\n  sourceUrl            String?\n  sourceFingerprint    String\n  cacheStatus          CacheStatus                @default(NOT_CACHED)\n  cacheProvider        StorageProvider?\n  cacheBucket          String?\n  cacheKey             String?\n  cacheChecksum        String?\n  cachedAt             DateTime?\n  cacheExpiresAt       DateTime?\n  cacheError           String?\n  currentVersionId     String?\n  syncStatus           AssetSyncStatus            @default(SYNCED)\n  lastSyncedAt         DateTime?\n  syncSummary          Json                       @default(\"{}\")\n  status               AssetStatus                @default(NEW)\n  batchIndex           Int                        @default(0)\n  orderIndex           Int                        @default(0)\n  description          String?\n  metadata             Json                       @default(\"{}\")\n  revision             Int                        @default(1)\n  createdAt            DateTime                   @default(now())\n  updatedAt            DateTime                   @updatedAt\n  archivedAt           DateTime?\n  deletedAt            DateTime?\n  annotations          Annotation[]\n  dataset              Dataset                    @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  externalRepository   ExternalRepository?        @relation(fields: [externalRepositoryId], references: [id])\n  uploadedBy           User?                      @relation(\"AssetUploadedBy\", fields: [uploadedById], references: [id])\n  assignedTo           User?                      @relation(\"AssetAssignedTo\", fields: [assignedToId], references: [id])\n  versions             AssetVersion[]\n  audioAsset           AudioAsset?\n  imageAsset           ImageAsset?\n  preparedImportItem   PreparedImportItem?\n  textAsset            TextAsset?\n  videoAsset           VideoAsset?\n  assetLabels          AssetLabel[]\n  workflowEvents       AssetWorkflowEvent[]\n  assignmentSlots      AssetAssignment[]\n  assignmentEvents     AssetAssignmentEvent[]\n  comments             AssetComment[]\n  notifications        Notification[]\n  outboxEvents         CollaborationOutboxEvent[]\n\n  @@unique([storageProvider, storageBucket, storageKey])\n  @@unique([cacheProvider, cacheBucket, cacheKey])\n  @@unique([datasetId, sourceFingerprint])\n  @@index([sourceFingerprint])\n  @@index([datasetId, modality])\n  @@index([datasetId, batchIndex])\n  @@index([datasetId, batchIndex, orderIndex])\n  @@index([datasetId, filename])\n  @@index([datasetId, status])\n  @@index([datasetId, syncStatus])\n  @@index([datasetId, cacheStatus])\n  @@index([uploadedById])\n  @@index([assignedToId])\n  @@index([externalRepositoryId])\n  @@index([sourceProvider])\n  @@index([sourceRevision])\n  @@index([sourcePath])\n  @@index([sourceFileSha])\n  @@index([sourceBlobSha])\n  @@index([sourceLfsOid])\n  @@index([currentVersionId])\n}\n\n/// The single current responsibility slot for each asset/type. Assignment\n/// history is append-only in AssetAssignmentEvent, so removing this slot does\n/// not erase attribution.\nmodel AssetAssignment {\n  id           String              @id @default(cuid())\n  datasetId    String\n  assetId      String\n  userId       String\n  type         AssetAssignmentType\n  assignedById String?\n  assignedAt   DateTime            @default(now())\n  updatedAt    DateTime            @updatedAt\n  dataset      Dataset             @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  user         User                @relation(\"AssetAssignmentUser\", fields: [userId], references: [id], onDelete: Restrict)\n  assignedBy   User?               @relation(\"AssetAssignmentCreatedBy\", fields: [assignedById], references: [id], onDelete: SetNull)\n\n  @@unique([assetId, type])\n  @@index([datasetId, type])\n  @@index([userId, type])\n}\n\nmodel AssetAssignmentEvent {\n  id             String                     @id @default(cuid())\n  datasetId      String\n  assetId        String\n  assignmentId   String?\n  action         AssetAssignmentEventAction\n  previousUserId String?\n  nextUserId     String?\n  actorId        String?\n  createdAt      DateTime                   @default(now())\n  dataset        Dataset                    @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  asset          Asset                      @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  actor          User?                      @relation(\"AssetAssignmentEventActor\", fields: [actorId], references: [id], onDelete: SetNull)\n\n  @@index([assetId, createdAt])\n  @@index([datasetId, createdAt])\n  @@index([assignmentId])\n}\n\nmodel AssetComment {\n  id            String           @id @default(cuid())\n  datasetId     String\n  assetId       String\n  authorId      String\n  parentId      String?\n  body          String\n  createdAt     DateTime         @default(now())\n  updatedAt     DateTime         @updatedAt\n  deletedAt     DateTime?\n  resolvedAt    DateTime?\n  resolvedById  String?\n  dataset       Dataset          @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  asset         Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  author        User             @relation(\"AssetCommentAuthor\", fields: [authorId], references: [id], onDelete: Restrict)\n  parent        AssetComment?    @relation(\"AssetCommentReplies\", fields: [parentId], references: [id], onDelete: Restrict)\n  replies       AssetComment[]   @relation(\"AssetCommentReplies\")\n  resolvedBy    User?            @relation(\"AssetCommentResolver\", fields: [resolvedById], references: [id], onDelete: SetNull)\n  mentions      CommentMention[]\n  notifications Notification[]\n\n  @@index([assetId, parentId, createdAt])\n  @@index([datasetId, createdAt])\n  @@index([authorId, createdAt])\n}\n\nmodel CommentMention {\n  id        String       @id @default(cuid())\n  commentId String\n  userId    String\n  createdAt DateTime     @default(now())\n  comment   AssetComment @relation(fields: [commentId], references: [id], onDelete: Cascade)\n  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)\n\n  @@unique([commentId, userId])\n  @@index([userId, createdAt])\n}\n\nmodel Notification {\n  id                   String           @id @default(cuid())\n  userId               String\n  type                 NotificationType\n  datasetId            String?\n  assetId              String?\n  commentId            String?\n  actorId              String?\n  title                String\n  body                 String\n  dedupeKey            String\n  contextUnavailableAt DateTime?\n  readAt               DateTime?\n  createdAt            DateTime         @default(now())\n  user                 User             @relation(\"NotificationRecipient\", fields: [userId], references: [id], onDelete: Cascade)\n  actor                User?            @relation(\"NotificationActor\", fields: [actorId], references: [id], onDelete: SetNull)\n  dataset              Dataset?         @relation(fields: [datasetId], references: [id], onDelete: SetNull)\n  asset                Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)\n  comment              AssetComment?    @relation(fields: [commentId], references: [id], onDelete: SetNull)\n\n  @@unique([userId, dedupeKey])\n  @@index([userId, readAt, createdAt])\n  @@index([datasetId, createdAt])\n  @@index([assetId, createdAt])\n}\n\nmodel DatasetMembershipEvent {\n  id           String                       @id @default(cuid())\n  datasetId    String\n  memberUserId String\n  actorId      String?\n  action       DatasetMembershipEventAction\n  previousRole DatasetMemberRole?\n  nextRole     DatasetMemberRole?\n  createdAt    DateTime                     @default(now())\n  dataset      Dataset                      @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  member       User                         @relation(\"DatasetMembershipEventMember\", fields: [memberUserId], references: [id], onDelete: Restrict)\n  actor        User?                        @relation(\"DatasetMembershipEventActor\", fields: [actorId], references: [id], onDelete: SetNull)\n\n  @@index([datasetId, createdAt])\n  @@index([memberUserId, createdAt])\n}\n\n/// Durable delivery intent. It is not Activity and it is never consumed by a\n/// browser or gateway. The private worker resolves it through the linked Job.\nmodel CollaborationOutboxEvent {\n  id              String                       @id @default(cuid())\n  datasetId       String\n  assetId         String?\n  recipientUserId String?\n  actorId         String?\n  jobId           String                       @unique\n  type            CollaborationOutboxEventType\n  dedupeKey       String                       @unique\n  payload         Json                         @default(\"{}\")\n  dispatchedAt    DateTime?\n  createdAt       DateTime                     @default(now())\n  dataset         Dataset                      @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  asset           Asset?                       @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  recipient       User?                        @relation(\"CollaborationOutboxRecipient\", fields: [recipientUserId], references: [id], onDelete: SetNull)\n  actor           User?                        @relation(\"CollaborationOutboxActor\", fields: [actorId], references: [id], onDelete: SetNull)\n  job             Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)\n\n  @@index([datasetId, dispatchedAt, createdAt])\n  @@index([recipientUserId, createdAt])\n  @@index([assetId, createdAt])\n}\n\n/// Append-only audit trail for the Asset.status review workflow. This is\n/// history only; Asset.status remains the sole workflow-state authority.\nmodel AssetWorkflowEvent {\n  id            String              @id @default(cuid())\n  assetId       String\n  actorId       String\n  action        AssetWorkflowAction\n  fromStatus    AssetStatus?\n  toStatus      AssetStatus?\n  assetRevision Int\n  feedback      String?\n  createdAt     DateTime            @default(now())\n  asset         Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  actor         User                @relation(\"AssetWorkflowActor\", fields: [actorId], references: [id], onDelete: Restrict)\n\n  @@index([assetId, createdAt])\n  @@index([actorId, createdAt])\n}\n\n/// *\n///  * Asset-level metadata label attachment (Phase 022). Fully independent of\n///  * `Annotation.labelId`: attaching/detaching an AssetLabel never creates,\n///  * modifies, or deletes an Annotation, even when an Annotation on the same\n///  * Asset happens to reference the same Label. See\n///  * specs/022-asset-browser-dataset-management-workspace/data-model.md.\nmodel AssetLabel {\n  id          String   @id @default(cuid())\n  assetId     String\n  labelId     String\n  createdAt   DateTime @default(now())\n  createdById String?\n  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  label       Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)\n  createdBy   User?    @relation(\"AssetLabelCreatedBy\", fields: [createdById], references: [id])\n\n  @@unique([assetId, labelId])\n  @@index([labelId])\n  @@index([createdById])\n}\n\nmodel AssetVersion {\n  id                   String              @id @default(cuid())\n  assetId              String\n  datasetId            String\n  versionNumber        Int\n  isCurrent            Boolean             @default(false)\n  modality             Modality\n  sourceMode           DatasetSourceMode\n  externalRepositoryId String?\n  sourceProvider       RepoProvider?\n  sourceRef            String?\n  sourceRevision       String?\n  sourcePath           String?\n  sourceFileSha        String?\n  sourceBlobSha        String?\n  sourceLfsOid         String?\n  sourceEtag           String?\n  sourceUrl            String?\n  sourceFingerprint    String\n  storageProvider      StorageProvider?\n  storageBucket        String?\n  storageKey           String?\n  checksum             String?\n  cacheStatus          CacheStatus         @default(NOT_CACHED)\n  cacheProvider        StorageProvider?\n  cacheBucket          String?\n  cacheKey             String?\n  cacheChecksum        String?\n  cachedAt             DateTime?\n  cacheExpiresAt       DateTime?\n  cacheError           String?\n  filename             String\n  originalFilename     String?\n  mimeType             String\n  sizeBytes            BigInt?\n  width                Int?\n  height               Int?\n  durationMs           Int?\n  textLength           Int?\n  syncStatus           AssetSyncStatus     @default(SYNCED)\n  metadata             Json                @default(\"{}\")\n  createdAt            DateTime            @default(now())\n  updatedAt            DateTime            @updatedAt\n  annotations          Annotation[]\n  asset                Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  dataset              Dataset             @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  externalRepository   ExternalRepository? @relation(fields: [externalRepositoryId], references: [id])\n\n  @@unique([assetId, versionNumber])\n  @@unique([storageProvider, storageBucket, storageKey])\n  @@unique([cacheProvider, cacheBucket, cacheKey])\n  @@unique([datasetId, sourceFingerprint])\n  @@index([assetId])\n  @@index([datasetId])\n  @@index([datasetId, isCurrent])\n  @@index([externalRepositoryId])\n  @@index([sourceRevision])\n  @@index([sourcePath])\n  @@index([sourceFileSha])\n  @@index([sourceBlobSha])\n  @@index([sourceLfsOid])\n  @@index([syncStatus])\n  @@index([cacheStatus])\n  @@index([sourceFingerprint])\n}\n\nmodel Label {\n  id             String             @id @default(cuid())\n  datasetId      String\n  modality       Modality?\n  scope          LabelScope         @default(OBJECT)\n  name           String\n  normalizedName String\n  color          String\n  description    String?\n  hotkey         String?\n  properties     Json               @default(\"{}\")\n  createdAt      DateTime           @default(now())\n  updatedAt      DateTime           @updatedAt\n  annotations    Annotation[]\n  dataset        Dataset            @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  videoTracks    VideoObjectTrack[] @relation(\"TrackLabel\")\n  assetLabels    AssetLabel[]\n\n  @@unique([datasetId, normalizedName])\n  @@index([datasetId])\n  @@index([datasetId, scope])\n  @@index([datasetId, modality])\n}\n\nmodel Annotation {\n  id                    String            @id @default(cuid())\n  datasetId             String\n  assetId               String\n  assetVersionId        String?\n  labelId               String?\n  createdById           String\n  updatedById           String?\n  reviewedById          String?\n  modality              Modality\n  type                  AnnotationType\n  source                AnnotationSource  @default(MANUAL)\n  /// *\n  ///    * Canonical geometry payload.\n  ///    * Validate this with Zod/application schemas.\n  geometry              Json              @default(\"{}\")\n  /// *\n  ///    * Metadata, model provenance, confidence, notes, custom fields.\n  properties            Json              @default(\"{}\")\n  status                AnnotationStatus  @default(DRAFT)\n  revision              Int               @default(1)\n  frameIndex            Int?\n  timestampMs           Int?\n  trackId               String?\n  isKeyframe            Boolean           @default(false)\n  isInterpolated        Boolean           @default(false)\n  startMs               Int?\n  endMs                 Int?\n  startChar             Int?\n  endChar               Int?\n  startToken            Int?\n  endToken              Int?\n  tokenIndex            Int?\n  sentenceIndex         Int?\n  textValue             String?\n  fromAnnotationId      String?\n  toAnnotationId        String?\n  speakerId             String?\n  createdAt             DateTime          @default(now())\n  updatedAt             DateTime          @updatedAt\n  asset                 Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  assetVersion          AssetVersion?     @relation(fields: [assetVersionId], references: [id])\n  createdBy             User              @relation(\"AnnotationCreatedBy\", fields: [createdById], references: [id])\n  dataset               Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  fromAnnotation        Annotation?       @relation(\"TextRelationFrom\", fields: [fromAnnotationId], references: [id])\n  outgoingTextRelations Annotation[]      @relation(\"TextRelationFrom\")\n  label                 Label?            @relation(fields: [labelId], references: [id])\n  reviewedBy            User?             @relation(\"AnnotationReviewedBy\", fields: [reviewedById], references: [id])\n  audioSpeaker          AudioSpeaker?     @relation(fields: [speakerId], references: [id])\n  toAnnotation          Annotation?       @relation(\"TextRelationTo\", fields: [toAnnotationId], references: [id])\n  incomingTextRelations Annotation[]      @relation(\"TextRelationTo\")\n  track                 VideoObjectTrack? @relation(fields: [trackId], references: [id])\n  updatedBy             User?             @relation(\"AnnotationUpdatedBy\", fields: [updatedById], references: [id])\n\n  @@index([datasetId, modality])\n  @@index([datasetId, status])\n  @@index([assetId, type])\n  @@index([assetId, status, createdAt])\n  @@index([assetVersionId])\n  @@index([labelId])\n  @@index([createdById])\n  @@index([assetId, frameIndex])\n  @@index([trackId, frameIndex])\n  @@index([assetId, timestampMs])\n  @@index([assetId, startMs, endMs])\n  @@index([assetId, startChar, endChar])\n  @@index([assetId, tokenIndex])\n  @@index([fromAnnotationId, toAnnotationId])\n  @@index([speakerId])\n}\n\nmodel ImageAsset {\n  id           String  @id @default(cuid())\n  assetId      String  @unique\n  thumbnailKey String?\n  exif         Json    @default(\"{}\")\n  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)\n}\n\nmodel VideoAsset {\n  id              String             @id @default(cuid())\n  assetId         String             @unique\n  fps             Float?\n  totalFrames     Int?\n  codec           String?\n  thumbnailKey    String?\n  frameStorageKey String?\n  metadata        Json               @default(\"{}\")\n  asset           Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  tracks          VideoObjectTrack[]\n\n  @@index([assetId])\n}\n\nmodel VideoObjectTrack {\n  id                String                 @id @default(cuid())\n  videoAssetId      String\n  labelId           String?\n  createdById       String?\n  name              String?\n  color             String?\n  properties        Json                   @default(\"{}\")\n  status            AnnotationStatus       @default(DRAFT)\n  revision          Int                    @default(1)\n  annotationType    AnnotationType         @default(BOUNDING_BOX)\n  interpolationMode VideoInterpolationMode @default(LINEAR)\n  createdAt         DateTime               @default(now())\n  updatedAt         DateTime               @updatedAt\n  annotations       Annotation[]\n  createdBy         User?                  @relation(\"TrackCreatedBy\", fields: [createdById], references: [id])\n  label             Label?                 @relation(\"TrackLabel\", fields: [labelId], references: [id])\n  videoAsset        VideoAsset             @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)\n\n  @@index([videoAssetId])\n  @@index([labelId])\n  @@index([createdById])\n}\n\nmodel TextAsset {\n  id           String  @id @default(cuid())\n  assetId      String  @unique\n  content      String?\n  language     String?\n  tokenization Json    @default(\"{}\")\n  metadata     Json    @default(\"{}\")\n  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)\n\n  @@index([assetId])\n}\n\nmodel AudioAsset {\n  id          String         @id @default(cuid())\n  assetId     String         @unique\n  sampleRate  Int?\n  channels    Int?\n  codec       String?\n  bitRate     Int?\n  waveformKey String?\n  metadata    Json           @default(\"{}\")\n  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)\n  speakers    AudioSpeaker[]\n\n  @@index([assetId])\n}\n\nmodel AudioSpeaker {\n  id           String       @id @default(cuid())\n  audioAssetId String\n  externalId   String?\n  name         String?\n  role         String?\n  color        String?\n  properties   Json         @default(\"{}\")\n  createdAt    DateTime     @default(now())\n  updatedAt    DateTime     @updatedAt\n  annotations  Annotation[]\n  audioAsset   AudioAsset   @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)\n\n  @@unique([audioAssetId, externalId])\n  @@index([audioAssetId])\n}\n\nmodel AiTask {\n  id                   String       @id @default(cuid())\n  externalTaskId       String?      @unique\n  datasetId            String\n  jobId                String       @unique\n  createdById          String\n  type                 AiTaskType\n  status               AiTaskStatus @default(QUEUED)\n  modality             Modality?\n  modelId              String\n  modelNameSnapshot    String\n  modelVersionSnapshot String?\n  modelKeySnapshot     String\n  input                Json         @default(\"{}\")\n  output               Json?\n  summary              Json         @default(\"{}\")\n  error                String?\n  errorCode            String?\n  errorDetails         Json?\n  pollAttempts         Int          @default(0)\n  nextPollAt           DateTime?\n  resultStorageKey     String?\n  createdAt            DateTime     @default(now())\n  updatedAt            DateTime     @updatedAt\n  createdBy            User         @relation(\"AiTaskCreatedBy\", fields: [createdById], references: [id])\n  dataset              Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)\n  job                  Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)\n  model                AiModel      @relation(fields: [modelId], references: [id])\n\n  @@index([datasetId])\n  @@index([createdById])\n  @@index([status])\n  @@index([modelId])\n  @@index([nextPollAt])\n}\n\nmodel AiModel {\n  id          String     @id @default(cuid())\n  key         String     @unique // định danh ổn định, dùng khi gọi API đồng nghiệp\n  displayName String\n  provider    String // khớp AiProviderAdapter registry, VD: \"colleague-api\"\n  modality    Modality? // null = hỗ trợ đa modality\n  taskType    AiTaskType\n  isActive    Boolean    @default(true)\n  metadata    Json       @default(\"{}\")\n  createdAt   DateTime   @default(now())\n  updatedAt   DateTime   @updatedAt\n  aiTasks     AiTask[]\n\n  @@index([provider])\n  @@index([taskType])\n  @@index([isActive])\n}\n\nenum UserRole {\n  ADMIN\n  MANAGER\n  LABELER\n  REVIEWER\n}\n\nenum DatasetMemberRole {\n  OWNER\n  MANAGER\n  LABELER\n  REVIEWER\n}\n\nenum DatasetInvitationStatus {\n  PENDING\n  ACCEPTE