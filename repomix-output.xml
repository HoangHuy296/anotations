            application/json:
              schema: { $ref: '#/components/schemas/ApiError' }
        '409':
          description: VIDEO_TRACK_REVISION_CONFLICT, or VIDEO_KEYFRAME_TIMESTAMP_CONFLICT when a keyframe already exists at timestampMs on this track.
