      SOURCE_MAX_DECLARED_BYTES: ${SOURCE_MAX_DECLARED_BYTES:-}
      SOURCE_MAX_DURATION_MS: ${SOURCE_MAX_DURATION_MS:-}
      # 021-production-hardening-garbage-collection (US7/US8) -- web-only.
      # See apps/web/src/lib/config/production-hardening.ts for the
      # authoritative defaults/bounds this mirrors.
      RATE_LIMIT_AI_TASK_PER_MINUTE: ${RATE_LIMIT_AI_TASK_PER_MINUTE:-10}
      RATE_LIMIT_IMPORT_PER_MINUTE: ${RATE_LIMIT_IMPORT_PER_MINUTE:-10}
      RATE_LIMIT_EXPORT_PER_MINUTE: ${RATE_LIMIT_EXPORT_PER_MINUTE:-10}
      PAGINATION_MAX_PAGE_SIZE: ${PAGINATION_MAX_PAGE_SIZE:-100}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy
    ports:
      # Bound to loopback only, so this dev stack answers at
      # http://localhost:3000 while docker-compose.review.yaml's web answers
      # at http://10.0.0.123:3001 on its own port/LAN IP, without a
      # conflict. See docker-compose.review.yaml.
      - "3000:3000"

  worker:
    build:
      context: .
      dockerfile: apps/worker/Dockerfile
    environment:
      DATABASE_URL: ${DATABASE_URL_DOCKER}
      MINIO_ENDPOINT: http://minio:9000
      MINIO_ACCESS_KEY: ${MINIO_ACCESS_KEY:-admin_dev_user}
      MINIO_SECRET_KEY: ${MINIO_SECRET_KEY:-super_secret_password_123}
      MINIO_BUCKET: ${MINIO_BUCKET:-annotation-assets}
      REDIS_HOST: redis
      REDIS_PORT: ${REDIS_PORT:-6379}
      REDIS_PASSWORD: ${REDIS_PASSWORD:-U596K12nuf9bkP1LNC0szoTtmFwL300rBVWVyq9qr/c=}
      REDIS_DB: ${REDIS_DB:-0}
      BULLMQ_PREFIX: ${BULLMQ_PREFIX:-annotation-platform}
      EXPORT_QUEUE_NAME: ${EXPORT_QUEUE_NAME:-export-dataset}
      SOURCE_CONNECTION_ENCRYPTION_KEY: ${SOURCE_CONNECTION_ENCRYPTION_KEY:-wSA2xXBH4KiKxAjt9b38M8bqk6QbYzbs0p9AZkUp+4I=}
      GITEA_PUBLIC_URL: ${GITEA_PUBLIC_URL:-http://localhost:3100/}
      GITEA_INTERNAL_URL: ${GITEA_INTERNAL_URL:-http://gitea:3000}  
      GITHUB_API_BASE_URL: ${GITHUB_API_BASE_URL:-https://api.github.com}
      ANNOTATIONPLATFORM_RUNTIME: compose
      # Required only by the controlled fixture override; production remains
      # disabled by default and cannot enable it through browser input.
      REPOSITORY_PREFLIGHT_INTEGRATION_TESTS: ${REPOSITORY_PREFLIGHT_INTEGRATION_TESTS:-0}
      SOURCE_CONNECTION_TEST_MODE: ${SOURCE_CONNECTION_TEST_MODE:-}
      SOURCE_TRUSTED_TEST_HOSTS: ${SOURCE_TRUSTED_TEST_HOSTS:-}
      SOURCE_ALLOWED_IP_CIDRS: ${SOURCE_ALLOWED_IP_CIDRS:-}
      SOURCE_MAX_ROOT_DEPTH: ${SOURCE_MAX_ROOT_DEPTH:-}
      SOURCE_MAX_ROOT_LENGTH: ${SOURCE_MAX_ROOT_LENGTH:-}
      SOURCE_MAX_IMPORT_ITEMS: ${SOURCE_MAX_IMPORT_ITEMS:-}
      SOURCE_MAX_DECLARED_BYTES: ${SOURCE_MAX_DECLARED_BYTES:-}
      SOURCE_MAX_DURATION_MS: ${SOURCE_MAX_DURATION_MS:-}
      # 021-production-hardening-garbage-collection (US1/US4/US5) -- worker-only.
      # See apps/worker/src/config.ts's productionHardeningPolicySchema for
      # the authoritative defaults/bounds this mirrors. MINIO_ORPHAN_SCAN_DRY_RUN
      # defaults to true deliberately -- never flip this in a shared compose
      # file; enable a live sweep only per-run, with explicit review of the
      # candidate list first.
      JOB_RECOVERY_LEASE_GRACE_MS: ${JOB_RECOVERY_LEASE_GRACE_MS:-60000}
      JOB_MAX_RUNTIME_MS: ${JOB_MAX_RUNTIME_MS:-3600000}
      JOB_LOCK_DURATION_MS: ${JOB_LOCK_DURATION_MS:-30000}
      JOB_STALLED_INTERVAL_MS: ${JOB_STALLED_INTERVAL_MS:-30000}
      JOB_MAX_STALLED_COUNT: ${JOB_MAX_STALLED_COUNT:-1}
      JOB_EVENT_RETENTION_DAYS: ${JOB_EVENT_RETENTION_DAYS:-30}
      JOB_EVENT_CLEANUP_BATCH_SIZE: ${JOB_EVENT_CLEANUP_BATCH_SIZE:-500}
      MINIO_ORPHAN_GRACE_PERIOD_MS: ${MINIO_ORPHAN_GRACE_PERIOD_MS:-86400000}
      MINIO_ORPHAN_SCAN_DRY_RUN: ${MINIO_ORPHAN_SCAN_DRY_RUN:-true}
      TEMP_UPLOAD_RETENTION_MS: ${TEMP_UPLOAD_RETENTION_MS:-86400000}
      MINIO_TEMP_UPLOAD_LIFECYCLE_DAYS: ${MINIO_TEMP_UPLOAD_LIFECYCLE_DAYS:-7}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy

  realtime:
    build:
      context: .
      dockerfile: apps/realtime/Dockerfile
    environment:
      REALTIME_PORT: 3002
      REALTIME_TICKET_SECRET: ${REALTIME_TICKET_SECRET:?REALTIME_TICKET_SECRET is required}
      REDIS_HOST: redis
      REDIS_PORT: ${REDIS_PORT:-6379}
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
      REDIS_DB: ${REDIS_DB:-0}
      BULLMQ_PREFIX: ${BULLMQ_PREFIX:-annotation-platform}
    depends_on:
      redis:
        condition: service_healthy
    ports:
      - "127.0.0.1:${REALTIME_PORT:-3002}:3002"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3002/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 5s
  # Gitea PostgreSQL
  gitea-postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: gitea
      POSTGRES_PASSWORD: ${GITEA_DB_PASSWORD:?GITEA_DB_PASSWORD is required}
      POSTGRES_DB: gitea
    volumes:
      - gitea-postgres-data:/var/lib/postgresql/data
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB",
        ]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
  gitea:
    image: docker.gitea.com/gitea:1.27.0
    restart: unless-stopped

    environment:
      USER_UID: ${GITEA_USER_UID:-1000}
      USER_GID: ${GITEA_USER_GID:-1000}

      # Application
      GITEA__DEFAULT__APP_NAME: Annotation Platform Git Service
      GITEA__DEFAULT__RUN_MODE: prod

      # Database
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: gitea-postgres:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWD: ${GITEA_DB_PASSWORD:?GITEA_DB_PASSWORD is required}
      GITEA__database__SSL_MODE: disable

      # HTTP server
      GITEA__server__PROTOCOL: http
      GITEA__server__DOMAIN: localhost
      GITEA__server__HTTP_ADDR: 0.0.0.0
      GITEA__server__HTTP_PORT: 3000
      GITEA__server__ROOT_URL: ${GITEA_PUBLIC_URL:-http://localhost:3100/}

      # SSH clone URLs
      GITEA__server__SSH_DOMAIN: localhost
      GITEA__server__SSH_PORT: ${GITEA_SSH_PORT:-2222}
      GITEA__server__DISABLE_SSH: "false"

      # Git LFS for image/video/audio repositories
      GITEA__server__LFS_START_SERVER: "true"

      # Initial setup
      GITEA__security__INSTALL_LOCK: "true"

      # Local development:
      # Cho phép tạo user từ giao diện Gitea.
      # Production nên đổi thành true.
      GITEA__service__DISABLE_REGISTRATION: ${GITEA_DISABLE_REGISTRATION:-false}

      # Có thể đặt true nếu chỉ muốn authenticated users xem repositories.
      GITEA__service__REQUIRE_SIGNIN_VIEW: ${GITEA_REQUIRE_SIGNIN_VIEW:-false}

    volumes:
      - gitea-data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro

    ports:
      - "${GITEA_HTTP_PORT:-3100}:3000"
      - "${GITEA_SSH_PORT:-2222}:22"

    depends_on:
      gitea-postgres:
        condition: service_healthy

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/api/healthz >/dev/null 2>&1 || exit 1",
        ]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 30s
  github-fixture:
    image: node:22-alpine
    working_dir: /repo
    command: ["node", "apps/web/tests/fixtures/github-fixture-server.mjs"]
    environment:
      GITHUB_FIXTURE_PORT: 8080
    volumes:
    - .:/repo:ro
    ports:
      - "127.0.0.1:18080:8080"
    networks:
      default:
        aliases:
          - github-blocked-target

volumes:
  # Pinned to the volume names already in use on disk (from before the
  # top-level `name:` above existed, when Compose derived them from the
  # "anotations" directory-name project). Pinning `name:` here keeps this
  # stack attached to its real data now that the project name changed —
  # without it, Compose would compute new project-prefixed volume names and
  # start every service against empty volumes.
  postgres-data:
    name: anotations_postgres-data
  redis-data:
    name: anotations_redis-data
  minio-data:
    name: anotations_minio-data
  gitea-data:
    name: anotations_gitea-data
  gitea-postgres-data:
    name: anotations_gitea-postgres-data
</file>

</files>
