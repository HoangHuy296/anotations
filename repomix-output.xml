# Annotations domain schemas.
#
# The annotation API is Asset-scoped in the current implementation. There is no
# /api/annotations route.
#
# This file covers both IMAGE annotations (the original GET/PUT batch endpoint)
# and the VIDEO annotation sub-domain (tracks, keyframes, temporal labels), which
# also persists as Annotation/VideoObjectTrack rows and is grouped under the same
# Annotations tag rather than under Assets or Media.
#
# Source of truth (IMAGE):
#   apps/web/src/lib/annotations/safe-annotation.ts     (SafeAnnotation projection)
#   apps/web/src/lib/annotations/annotation-service.ts   (read/write behavior, error reasons)
#   apps/web/src/lib/validation/annotation-api.ts         (annotationChangeSetSchema, geometry union)
#   apps/web/src/app/api/assets/[assetId]/annotations/route.ts
#
# Source of truth (VIDEO):
#   apps/web/src/types/video-annotation.ts                (SafeVideoTrack/Keyframe/TemporalLabel/Annotations)
#   apps/web/src/lib/annotations/video-projection.ts       (toSafeVideo* projections)
#   apps/web/src/lib/annotations/video-read-service.ts     (GET .../video-annotations)
#   apps/web/src/lib/annotations/video-track-service.ts    (track create/update/delete)
#   apps/web/src/lib/annotations/video-keyframe-service.ts (keyframe create/update/delete)
#   apps/web/src/lib/annotations/video-temporal-label-service.ts (temporal label create/update/delete)
#   apps/web/src/lib/validation/video-annotation.ts        (all VIDEO request schemas)
#   apps/web/src/app/api/assets/[assetId]/video-annotations/route.ts
#   apps/web/src/app/api/assets/[assetId]/video-object-tracks/route.ts
#   apps/web/src/app/api/video-object-tracks/[trackId]/route.ts
#   apps/web/src/app/api/video-object-tracks/[trackId]/keyframes/route.ts
#   apps/web/src/app/api/video-keyframes/[annotationId]/route.ts
#   apps/web/src/app/api/assets/[assetId]/temporal-labels/route.ts
#   apps/web/src/app/api/temporal-labels/[annotationId]/route.ts
#   prisma/schema.prisma (AnnotationType, AnnotationStatus enums)

AnnotationType:
  type: string
  description: >-
    Full Prisma AnnotationType enum. GET returns whatever type an annotation was
    persisted with, including types created outside this write endpoint (for example
    by an AI prediction pipeline). PUT (see AnnotationChangeSet) only accepts the five
    geometry-backed types below -- BOUNDING_BOX, POLYGON, CIRCLE, POINT, POLYLINE --
    because imageAnnotationGeometrySchema is a closed discriminated union over just
    those five. Read is intentionally broader than write; this is not a contract bug.
  enum:
    - BOUNDING_BOX
    - ROTATED_BOUNDING_BOX
    - POLYGON
    - CIRCLE
    - POINT
    - POLYLINE
    - SEGMENTATION_MASK
    - KEYPOINT
    - IMAGE_CLASSIFICATION
    - VIDEO_CLASSIFICATION

WritableAnnotationType:
  type: string
  description: The closed set of types accepted by PUT .../annotations (imageAnnotationGeometrySchema).
  enum: [BOUNDING_BOX, POLYGON, CIRCLE, POINT, POLYLINE]

AnnotationStatus:
  type: string
  enum: [DRAFT, IN_PROGRESS, COMPLETED, SUBMITTED, REVIEWED, ACCEPTED, REJECTED]

Coordinate:
  type: number
  minimum: 0
  maximum: 1
  description: Coordinates are normalized to the original image, in the [0, 1] range.

Point2D:
  type: array
  items:
    $ref: '#/Coordinate'
  minItems: 2
  maxItems: 2

BoundingBoxGeometry:
  type: object
  required: [x, y, width, height]
  properties:
    x: { $ref: '#/Coordinate' }
    y: { $ref: '#/Coordinate' }
    width:
      type: number
      exclusiveMinimum: 0
      maximum: 1
    height:
      type: number
      exclusiveMinimum: 0
      maximum: 1
  additionalProperties: false
  description: Server also rejects (x + width > 1) or (y + height > 1) -- box must stay within the image.

PolygonGeometry:
  type: object
  required: [points]
  properties:
    points:
      type: array
      items: { $ref: '#/Point2D' }
      minItems: 3
      maxItems: 1000
      description: Points must be pairwise distinct.
  additionalProperties: false

PolylineGeometry:
  type: object
  required: [points]
  properties:
    points:
      type: array
      items: { $ref: '#/Point2D' }
      minItems: 2
      maxItems: 1000
      description: Points must be pairwise distinct.
  additionalProperties: false

CircleGeometry:
  type: object
  required: [cx, cy, r]
  properties:
    cx: { $ref: '#/Coordinate' }
    cy: { $ref: '#/Coordinate' }
    r:
      type: number
      exclusiveMinimum: 0
      maximum: 1
  additionalProperties: false
  description: Server also rejects a circle whose bounds fall outside [0, 1].

PointGeometry:
  type: object
  required: [px, py]
  properties:
    px: { $ref: '#/Coordinate' }
    py: { $ref: '#/Coordinate' }
  additionalProperties: false

AnnotationGeometry:
  description: >-
    Discriminated union matching imageAnnotationGeometrySchema. The `type` field
    determines which `geometry` shape is required.
  oneOf:
    - type: object
      required: [type, geometry]
      properties:
        type: { type: string, enum: [BOUNDING_BOX] }
        geometry: { $ref: '#/BoundingBoxGeometry' }
      additionalProperties: false
    - type: object
      required: [type, geometry]
      properties:
        type: { type: string, enum: [POLYGON] }
        geometry: { $ref: '#/PolygonGeometry' }
      additionalProperties: false
    - type: object
      required: [type, geometry]
      properties:
        type: { type: string, enum: [CIRCLE] }
        geometry: { $ref: '#/CircleGeometry' }
      additionalProperties: false
    - type: object
      required: [type, geometry]
      properties:
        type: { type: string, enum: [POINT] }
        geometry: { $ref: '#/PointGeometry' }
      additionalProperties: false
    - type: object
      required: [type, geometry]
      properties:
        type: { type: string, enum: [POLYLINE] }
        geometry: { $ref: '#/PolylineGeometry' }
      additionalProperties: false

AnnotationLabel:
  type: [object, "null"]
  description: Safe label projection embedded in an annotation. Null when labelId is null.
  required: [id, name, color]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    name:
      type: string
    color:
      type: string
  additionalProperties: false

Annotation:
  type: object
  description: >-
    Safe annotation projection (SafeAnnotation). Returned by both GET and PUT. Never
    includes createdById/updatedById/reviewedById or any other internal actor
    reference.
  required:
    - id
    - assetId
    - labelId
    - label
    - modality
    - type
    - geometry
    - status
    - properties
    - revision
    - createdAt
    - updatedAt
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    assetId:
      $ref: './common.yaml#/Cuid'
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    label:
      $ref: '#/AnnotationLabel'
    modality:
      $ref: './assets.yaml#/Modality'
    type:
      $ref: '#/AnnotationType'
    geometry:
      description: >-
        Shape matches the geometry variant for `type`. Typed as an open schema here
        because GET does not re-validate persisted geometry against the write-time
        union.
      type: object
    status:
      $ref: '#/AnnotationStatus'
    properties:
      description: Free-form per-annotation properties bag. Empty object ({}) for annotations created through this API.
      type: object
    revision:
      type: integer
      minimum: 1
      description: Optimistic-concurrency counter. Required on every update/delete to guard against stale overwrites.
    createdAt:
      $ref: './common.yaml#/Timestamp'
    updatedAt:
      $ref: './common.yaml#/Timestamp'
  additionalProperties: false

AnnotationListResponse:
  type: object
  required: [annotations]
  properties:
    annotations:
      type: array
      items:
        $ref: '#/Annotation'
      description: Empty array when the asset has no annotations. Never null.
  additionalProperties: false

AnnotationCreate:
  description: >-
    One new annotation. `id` is client-supplied (used as an idempotency/replay key --
    a duplicate create with an identical id+type+geometry+labelId from the same actor
    on the same asset is accepted as a no-op replay rather than an error; a duplicate
    id with different content is rejected as ANNOTATION_CREATE_REPLAY_CONFLICT).
  allOf:
    - type: object
      required: [id]
      properties:
        id:
          $ref: './common.yaml#/Cuid'
        labelId:
          oneOf:
            - $ref: './common.yaml#/Cuid'
            - type: "null"
      additionalProperties: false
    - $ref: '#/AnnotationGeometry'

AnnotationUpdate:
  type: object
  description: >-
    At least one of geometry or labelId must be present (server rejects an update that
    changes neither). labelId: null explicitly clears the label; omitting labelId
    leaves it unchanged.
  required: [id, revision]
  minProperties: 3
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    revision:
      type: integer
      minimum: 1
      description: Must match the annotation's current persisted revision or the update is rejected as a conflict.
    geometry:
      description: One of BoundingBoxGeometry / PolygonGeometry / CircleGeometry / PointGeometry / PolylineGeometry, matching the annotation's existing (immutable) type.
      oneOf:
        - $ref: '#/BoundingBoxGeometry'
        - $ref: '#/PolygonGeometry'
        - $ref: '#/CircleGeometry'
        - $ref: '#/PointGeometry'
        - $ref: '#/PolylineGeometry'
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
  additionalProperties: false

AnnotationDelete:
  type: object
  required: [id, revision]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    revision:
      type: integer
      minimum: 1
  additionalProperties: false

AnnotationChangeSet:
  type: object
  description: >-
    Bounded, transactional mutation batch. Source: annotationChangeSetSchema. Combined
    creates+updates+deletes must not exceed 100 items; an id may not repeat within
    updates+deletes, and may not repeat within creates. All three arrays default to []
    when omitted.
  properties:
    creates:
      type: array
      items:
        $ref: '#/AnnotationCreate'
      maxItems: 100
      default: []
    updates:
      type: array
      items:
        $ref: '#/AnnotationUpdate'
      maxItems: 100
      default: []
    deletes:
      type: array
      items:
        $ref: '#/AnnotationDelete'
      maxItems: 100
      default: []
  additionalProperties: false

# ===========================================================================
# VIDEO annotation sub-domain
# ===========================================================================
# A VIDEO annotation is never a bare shape: every keyframe geometry belongs to
# a VideoObjectTrack (an "object" being tracked across the clip) and is
# anchored to a timestamp. Frames between two persisted keyframes on the same
# track are filled by server-computed interpolation, which is returned on GET
# but never itself writable or persisted.

VideoInterpolationMode:
  type: string
  enum: [LINEAR, NONE]

VideoBoundingBoxGeometry:
  type: object
  description: The only geometry kind VIDEO keyframes currently support.
  required: [x, y, width, height]
  properties:
    kind:
      type: string
      enum: [BOUNDING_BOX]
      default: BOUNDING_BOX
    x: { $ref: '#/Coordinate' }
    y: { $ref: '#/Coordinate' }
    width:
      type: number
      exclusiveMinimum: 0
      maximum: 1
    height:
      type: number
      exclusiveMinimum: 0
      maximum: 1
  additionalProperties: false
  examples: [{ kind: BOUNDING_BOX, x: 0.1, y: 0.1, width: 0.2, height: 0.2 }]

VideoObjectTrack:
  type: object
  description: Safe projection of a VideoObjectTrack row (SafeVideoTrack).
  required: [id, videoAssetId, labelId, label, name, annotationType, interpolationMode, status, revision, properties, createdAt, updatedAt]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    videoAssetId: { $ref: './common.yaml#/Cuid' }
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    label:
      $ref: '#/AnnotationLabel'
    name:
      type: [string, "null"]
    annotationType:
      description: Currently always BOUNDING_BOX -- videoTrackCreateSchema pins this literal.
      type: string
      enum: [BOUNDING_BOX]
    interpolationMode:
      $ref: '#/VideoInterpolationMode'
    status:
      $ref: '#/AnnotationStatus'
    revision:
      type: integer
      minimum: 1
      description: Optimistic-concurrency counter for this track. Every keyframe/temporal-label mutation under it is guarded by expectedTrackRevision matching this value.
    properties:
      type: object
    createdAt: { $ref: './common.yaml#/Timestamp' }
    updatedAt: { $ref: './common.yaml#/Timestamp' }
  additionalProperties: false

VideoKeyframe:
  type: object
  description: Safe projection of an Annotation row with trackId set and isKeyframe true (SafeVideoKeyframe).
  required: [id, trackId, assetId, labelId, type, geometry, properties, timestampMs, revision, createdAt, updatedAt]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    trackId: { $ref: './common.yaml#/Cuid' }
    assetId: { $ref: './common.yaml#/Cuid' }
    labelId:
      description: Per-keyframe label override; independent of the parent track's labelId.
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    type:
      type: string
      enum: [BOUNDING_BOX]
    geometry:
      $ref: '#/VideoBoundingBoxGeometry'
    properties:
      type: object
    timestampMs:
      type: integer
      minimum: 0
    revision:
      type: integer
      minimum: 1
    createdAt: { $ref: './common.yaml#/Timestamp' }
    updatedAt: { $ref: './common.yaml#/Timestamp' }
  additionalProperties: false

VideoTemporalLabelType:
  type: string
  enum: [EVENT, SCENE, SHOT_BOUNDARY]

VideoTemporalLabel:
  type: object
  description: Safe projection of an untracked Annotation row (no trackId) typed EVENT/SCENE/SHOT_BOUNDARY (SafeVideoTemporalLabel).
  required: [id, assetId, labelId, type, startMs, endMs, revision, properties, createdAt, updatedAt]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    assetId: { $ref: './common.yaml#/Cuid' }
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    type:
      $ref: '#/VideoTemporalLabelType'
    startMs:
      type: integer
      minimum: 0
    endMs:
      type: integer
      minimum: 0
      description: Must be strictly greater than startMs (enforced on create).
    revision:
      type: integer
      minimum: 1
    properties:
      type: object
    createdAt: { $ref: './common.yaml#/Timestamp' }
    updatedAt: { $ref: './common.yaml#/Timestamp' }
  additionalProperties: false

DerivedVideoInterpolation:
  type: object
  description: >-
    Computed, read-only frame between two persisted keyframes on the same track.
    Never a persisted row of its own -- only returned when both fromMs and toMs
    query parameters are supplied to GET .../video-annotations.
  allOf:
    - $ref: '#/VideoBoundingBoxGeometry'
    - type: object
      required: [timestampMs, trackId, derived]
      properties:
        timestampMs:
          type: integer
        trackId:
          $ref: './common.yaml#/Cuid'
        derived:
          type: boolean
          enum: [true]

VideoAnnotationsResponse:
  type: object
  description: Full VIDEO read model for one Asset -- persisted tracks/keyframes/temporal labels plus derived-only interpolation frames.
  required: [assetId, durationMs, fps, tracks, keyframes, temporalLabels, interpolation]
  properties:
    assetId: { $ref: './common.yaml#/Cuid' }
    durationMs:
      type: [integer, "null"]
    fps:
      type: [number, "null"]
    tracks:
      type: array
      items: { $ref: '#/VideoObjectTrack' }
    keyframes:
      type: array
      items: { $ref: '#/VideoKeyframe' }
      description: Filtered to [fromMs, toMs] when both query params are supplied.
    temporalLabels:
      type: array
      items: { $ref: '#/VideoTemporalLabel' }
      description: Included when its [startMs, endMs] intersects the requested [fromMs, toMs] window.
    interpolation:
      type: array
      items: { $ref: '#/DerivedVideoInterpolation' }
      description: One entry per track, only when both fromMs and toMs are supplied.
  additionalProperties: false

VideoTrackCreateRequest:
  type: object
  description: "Source: videoTrackCreateSchema."
  properties:
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    name:
      type: string
      minLength: 1
      maxLength: 160
    annotationType:
      type: string
      enum: [BOUNDING_BOX]
      default: BOUNDING_BOX
    interpolationMode:
      $ref: '#/VideoInterpolationMode'
      default: LINEAR
    properties:
      type: object
      default: {}
  additionalProperties: false

VideoTrackUpdateRequest:
  type: object
  description: >-
    Source: videoTrackUpdateSchema. Must change at least one field besides
    expectedTrackRevision.
  required: [expectedTrackRevision]
  minProperties: 2
  properties:
    expectedTrackRevision:
      type: integer
      minimum: 1
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    name:
      type: string
      minLength: 1
      maxLength: 160
    status:
      $ref: '#/AnnotationStatus'
    interpolationMode:
      $ref: '#/VideoInterpolationMode'
    properties:
      type: object
  additionalProperties: false

VideoTrackDeleteRequest:
  type: object
  description: "Source: videoTrackDeleteSchema. DELETE carries a JSON body (not query params) with the expected revision."
  required: [expectedTrackRevision]
  properties:
    expectedTrackRevision:
      type: integer
      minimum: 1
  additionalProperties: false

VideoKeyframeCreateRequest:
  type: object
  description: "Source: videoKeyframeCreateSchema."
  required: [expectedTrackRevision, timestampMs, geometry]
  properties:
    expectedTrackRevision:
      type: integer
      minimum: 1
    timestampMs:
      type: integer
      minimum: 0
    geometry:
      $ref: '#/VideoBoundingBoxGeometry'
    properties:
      type: object
      default: {}
  additionalProperties: false

VideoKeyframeUpdateRequest:
  type: object
  description: "Source: videoKeyframeUpdateSchema. Must change at least one of timestampMs/geometry/properties/labelId."
  required: [expectedTrackRevision]
  minProperties: 2
  properties:
    expectedTrackRevision:
      type: integer
      minimum: 1
    timestampMs:
      type: integer
      minimum: 0
    geometry:
      $ref: '#/VideoBoundingBoxGeometry'
    properties:
      type: object
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
  additionalProperties: false

VideoKeyframeDeleteRequest:
  type: object
  description: "Source: videoKeyframeDeleteSchema."
  required: [expectedTrackRevision]
  properties:
    expectedTrackRevision:
      type: integer
      minimum: 1
  additionalProperties: false

VideoTemporalLabelCreateRequest:
  type: object
  description: "Source: videoTemporalLabelCreateSchema. startMs must be strictly less than endMs."
  required: [type, startMs, endMs]
  properties:
    type:
      $ref: '#/VideoTemporalLabelType'
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    startMs:
      type: integer
      minimum: 0
    endMs:
      type: integer
      minimum: 0
    properties:
      type: object
      default: {}
  additionalProperties: false

VideoTemporalLabelUpdateRequest:
  type: object
  description: "Source: videoTemporalLabelUpdateSchema. Must change at least one field besides expectedRevision."
  required: [expectedRevision]
  minProperties: 2
  properties:
    expectedRevision:
      type: integer
      minimum: 1
    labelId:
      oneOf:
        - $ref: './common.yaml#/Cuid'
        - type: "null"
    startMs:
      type: integer
      minimum: 0
    endMs:
      type: integer
      minimum: 0
    properties:
      type: object
  additionalProperties: false

VideoTemporalLabelDeleteRequest:
  type: object
  description: "Source: videoTemporalLabelDeleteSchema."
  required: [expectedRevision]
  properties:
    expectedRevision:
      type: integer
      minimum: 1
  additionalProperties: false
</file>

<file path="specs/api/schemas/asset-workflow.yaml">
# Annotation and review workflow (023) public API schemas.
# Source of truth: specs/023-annotation-review-workflow/contracts/asset-workflow.md

AssetWorkflowAction:
  type: string
  enum: [START, SUBMIT, OPEN_REVIEW, APPROVE, REJECT, START_REWORK, RESUBMIT]

AssetWorkflowActionRequest:
  type: object
  required: [action, expectedRevision]
  additionalProperties: false
  properties:
    action: { $ref: '#/AssetWorkflowAction' }
    expectedRevision: { type: integer, minimum: 1 }
    feedback:
      type: string
      minLength: 1
      maxLength: 2000
      description: Required only for REJECT; forbidden for all other actions.

AssetWorkflowEvent:
  type: object
  required: [id, action, assetRevision, createdAt]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    action: { $ref: '#/AssetWorkflowAction' }
    fromStatus: { oneOf: [{ $ref: './assets.yaml#/AssetStatus' }, { type: 'null' }] }
    toStatus: { oneOf: [{ $ref: './assets.yaml#/AssetStatus' }, { type: 'null' }] }
    assetRevision: { type: integer, minimum: 1 }
    feedback: { type: [string, 'null'] }
    createdAt: { $ref: './common.yaml#/Timestamp' }

AssetWorkflowAsset:
  type: object
  required: [id, status, revision]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    status: { $ref: './assets.yaml#/AssetStatus' }
    revision: { type: integer, minimum: 1 }

AssetWorkflowReadResponse:
  type: object
  required: [asset, history]
  properties:
    asset: { $ref: '#/AssetWorkflowAsset' }
    history:
      type: array
      items: { $ref: '#/AssetWorkflowEvent' }

AssetWorkflowActionResponse:
  type: object
  required: [asset, event]
  properties:
    asset: { $ref: '#/AssetWorkflowAsset' }
    event: { $ref: '#/AssetWorkflowEvent' }
</file>

<file path="specs/api/schemas/assets.yaml">
# Assets domain schemas.
#
# Scope note: this initial pass documents only the core upload/view/list surface
# (POST /api/assets/presigned-upload, POST /api/assets/complete-upload,
# GET /api/assets/{assetId}/view-url, GET /api/datasets/{datasetId}/assets).
# Asset-scoped sub-domains that exist in the repository but are out of scope for
# this pass -- media-processing, temporal-labels, video-annotations,
# video-object-tracks -- are intentionally not documented here; see the final
# report for the full excluded-route list.
#
# Source of truth:
#   apps/web/src/lib/asset-upload.ts            (PublishedAsset / SafeUploadedAsset)
#   apps/web/src/lib/validation/upload.ts        (presignedUploadSchema, completeUploadSchema)
#   apps/web/src/lib/validation/asset-list.ts    (assetListQuerySchema)
#   apps/web/src/app/api/assets/**/route.ts
#   apps/web/src/app/api/datasets/[datasetId]/assets/route.ts
#   prisma/schema.prisma (Modality, AssetStatus enums)

Modality:
  type: string
  enum: [IMAGE, VIDEO, TEXT, AUDIO]

AssetStatus:
  type: string
  enum: [NEW, PROCESSING, READY, IN_PROGRESS, COMPLETED, NEEDS_REVIEW, REVIEWED, REJECTED, SKIPPED, ARCHIVED, FAILED]

Asset:
  type: object
  description: >-
    Safe asset projection. Identical field set is used both for a single published/
    viewed asset and for each item in the dataset asset list -- both routes select
    the same assetMetadataSelect plus sizeBytes normalization (BigInt -> string).
    Never includes storageProvider/storageBucket/storageKey or any other
    storage-location detail.
  required:
    - id
    - datasetId
    - modality
    - filename
    - originalFilename
    - mimeType
    - sizeBytes
    - width
    - height
    - durationMs
    - textLength
    - status
    - batchIndex
    - orderIndex
    - description
    - revision
    - createdAt
    - updatedAt
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    datasetId:
      $ref: './common.yaml#/Cuid'
    modality:
      $ref: '#/Modality'
    filename:
      type: string
    originalFilename:
      type: [string, "null"]
    mimeType:
      type: string
    sizeBytes:
      type: [string, "null"]
      description: BigInt serialized as a decimal string.
    width:
      type: [integer, "null"]
    height:
      type: [integer, "null"]
    durationMs:
      type: [integer, "null"]
    textLength:
      type: [integer, "null"]
    status:
      $ref: '#/AssetStatus'
    batchIndex:
      type: integer
    orderIndex:
      type: integer
    description:
      type: [string, "null"]
    revision:
      type: integer
    createdAt:
      $ref: './common.yaml#/Timestamp'
    updatedAt:
      $ref: './common.yaml#/Timestamp'
  additionalProperties: false

AssetListPage:
  type: object
  description: Cursor pagination envelope returned by GET /api/datasets/{datasetId}/assets.
  required: [items, page]
  properties:
    items:
      type: array
      items:
        $ref: '#/Asset'
    page:
      type: object
      required: [limit, nextCursor, hasNextPage]
      properties:
        limit:
          type: integer
        nextCursor:
          $ref: './common.yaml#/Cuid'
        hasNextPage:
          type: boolean
      additionalProperties: false
  additionalProperties: false

PresignedUploadRequest:
  type: object
  description: "Source: presignedUploadSchema (apps/web/src/lib/validation/upload.ts)."
  required: [datasetId, filename, contentType, sizeBytes]
  properties:
    datasetId:
      $ref: './common.yaml#/Cuid'
    filename:
      type: string
      minLength: 1
      maxLength: 255
    contentType:
      type: string
      enum:
        - image/png
        - image/jpeg
        - image/webp
        - video/mp4
        - video/webm
        - text/plain
        - text/csv
        - application/json
        - audio/wav
        - audio/mpeg
        - audio/ogg
    sizeBytes:
      type: integer
      minimum: 1
      maximum: 104857600
      description: Hard cap is 100 MiB (MAX_DIRECT_UPLOAD_BYTES).
  additionalProperties: false

PresignedUploadResponse:
  type: object
  description: >-
    A backend-generated, object-scoped MinIO presigned POST policy. formFields must be
    submitted verbatim to uploadUrl and are not persisted or reusable beyond
    expiresInSeconds; see AGENTS.md security rules.
  required: [uploadUrl, method, formFields, fileId, expiresInSeconds]
  properties:
    uploadUrl:
      type: string
      format: uri
    method:
      type: string
      enum: [POST]
    formFields:
      type: object
      description: Provider-required signed multipart form fields for this one upload only.
      additionalProperties:
        type: string
    fileId:
      type: string
      description: >-
        Opaque upload-capability token to pass to POST /api/assets/complete-upload.
        Not a MinIO credential.
    expiresInSeconds:
      type: integer
  additionalProperties: false

CompleteUploadRequest:
  type: object
  description: "Source: completeUploadSchema (apps/web/src/lib/validation/upload.ts)."
  required: [fileId]
  properties:
    fileId:
      type: string
      minLength: 32
      maxLength: 8192
  additionalProperties: false

CompleteUploadResponse:
  type: object
  required: [asset, replayed]
  properties:
    asset:
      $ref: '#/Asset'
    replayed:
      type: boolean
      description: >-
        True when the object was already published by an earlier, duplicate completion
        call for the same upload capability (idempotent replay), rather than newly
        created by this request.
  additionalProperties: false

AssetViewUrlResponse:
  type: object
  required: [viewUrl, expiresAt]
  properties:
    viewUrl:
      type: string
      format: uri
      description: Short-lived, object-scoped MinIO presigned GET URL.
    expiresAt:
      $ref: './common.yaml#/Timestamp'
  additionalProperties: false
</file>

<file path="specs/api/schemas/authentication.yaml">
# Authentication domain schemas.
#
# Source of truth:
#   apps/web/src/lib/auth.ts               (RequestActor / SafeUser, session cookie)
#   apps/web/src/lib/validation/auth.ts    (credentialsSchema, registrationSchema,
#                                            profileSchema, passwordChangeSchema)
#   apps/web/src/app/api/auth/**/route.ts

UserRole:
  type: string
  description: >-
    Prisma UserRole enum. Self-service registration (POST /api/auth/signup) can only
    create MANAGER, LABELER, or REVIEWER accounts -- ADMIN is excluded by
    registrationSchema and can only exist via a channel outside this API.
  enum: [ADMIN, MANAGER, LABELER, REVIEWER]

AuthenticatedUser:
  type: object
  description: >-
    The safe actor projection (RequestActor) returned by every authentication endpoint
    that returns a user. Never includes passwordHash or any session/token material.
  required: [id, email, name, role]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    email:
      type: string
      format: email
    name:
      type: string
      description: Display name; falls back to the account email when no name was set.
    role:
      $ref: '#/UserRole'
  additionalProperties: false

LoginRequest:
  type: object
  description: "Source: credentialsSchema (apps/web/src/lib/validation/auth.ts). Zod .strict() -- unknown fields are rejected."
  required: [email, password]
  properties:
    email:
      type: string
      format: email
      maxLength: 320
    password:
      type: string
      minLength: 12
      maxLength: 256
  additionalProperties: false

SignupRequest:
  type: object
  description: >-
    Source: registrationSchema, which extends credentialsSchema. Zod .strict() --
    unknown fields (including "role": "ADMIN") are rejected outright, not silently
    dropped.
  required: [email, password, role]
  properties:
    email:
      type: string
      format: email
      maxLength: 320
    password:
      type: string
      minLength: 12
      maxLength: 256
    name:
      type: string
      minLength: 1
      maxLength: 100
    role:
      type: string
      enum: [MANAGER, LABELER, REVIEWER]
      description: ADMIN is intentionally not an allowed value for self-service signup.
  additionalProperties: false

ProfileUpdateRequest:
  type: object
  description: >-
    Source: profileSchema. Deliberately excludes email and role -- those are not
    self-service editable fields in the current implementation.
  required: [name]
  properties:
    name:
      type: string
      minLength: 1
      maxLength: 100
  additionalProperties: false

PasswordChangeRequest:
  type: object
  description: >-
    Source: passwordChangeSchema. The schema itself rejects newPassword equal to
    currentPassword (Zod .refine on the object, surfaced as a fieldErrors entry on
    "newPassword").
  required: [currentPassword, newPassword]
  properties:
    currentPassword:
      type: string
      minLength: 1
      maxLength: 256
    newPassword:
      type: string
      minLength: 12
      maxLength: 256
  additionalProperties: false

PasswordChangeResponse:
  type: object
  required: [changed]
  properties:
    changed:
      type: boolean
      enum: [true]
  additionalProperties: false
</file>

<file path="specs/api/schemas/bulk-assets.yaml">
# Asset Browser & Dataset Management Workspace (022) -- bulk-mutation domain schemas.
#
# Source of truth:
#   apps/web/src/lib/validation/asset-bulk.ts       (assetBulkRequestSchema)
#   apps/web/src/types/workspace.ts                 (BulkSelection, BulkOperationResult, BULK_SYNC_MAX_ASSETS)
#   apps/web/src/app/api/datasets/[datasetId]/assets/bulk/route.ts
#   apps/web/src/app/api/datasets/[datasetId]/members/route.ts
#   apps/web/src/app/api/export-selected/[jobId]/route.ts

AssetBulkAction:
  type: string
  enum: [ADD_LABEL, REMOVE_LABEL, CHANGE_STATUS, ASSIGN, DELETE, EXPORT_SELECTED]

AssetBulkSelectionQuery:
  type: object
  description: >-
    The subset of GET /api/datasets/{datasetId}/assets's filters that a FILTERED
    selection matches against. Deliberately excludes sort/order/cursor/limit --
    sort never defines selection membership.
  additionalProperties: false
  properties:
    q:
      type: string
      minLength: 1
      maxLength: 100
    status:
      type: array
      items: { $ref: './assets.yaml#/AssetStatus' }
    modality:
      $ref: './assets.yaml#/Modality'
    labelId:
      type: array
      items: { $ref: './common.yaml#/Cuid' }
    assignedToId:
      $ref: './common.yaml#/Cuid'
    createdFrom: { $ref: './common.yaml#/Timestamp' }
    createdTo: { $ref: './common.yaml#/Timestamp' }
    updatedFrom: { $ref: './common.yaml#/Timestamp' }
    updatedTo: { $ref: './common.yaml#/Timestamp' }

AssetBulkSelection:
  oneOf:
    - type: object
      required: [mode, assetIds]
      additionalProperties: false
      properties:
        mode: { type: string, enum: [EXPLICIT] }
        assetIds:
          type: array
          minItems: 1
          maxItems: 1000
          items: { $ref: './common.yaml#/Cuid' }
    - type: object
      required: [mode, query]
      additionalProperties: false
      properties:
        mode: { type: string, enum: [FILTERED] }
        query: { $ref: '#/AssetBulkSelectionQuery' }

AssetBulkRequest:
  type: object
  description: >-
    One request shape for every bulk action (022 architecture principle: one
    coherent bulk-operation boundary, not one route per button). `payload`'s
    shape depends on `action` -- see the route's own request validation for the
    exact per-action fields (labelId/createLabel for ADD_LABEL, status for
    CHANGE_STATUS, assignedToId for ASSIGN, an empty object for DELETE/EXPORT_SELECTED).
    Phase 023 reserves IN_PROGRESS, NEEDS_REVIEW, REVIEWED, and REJECTED for
    the revision-guarded Asset workflow endpoint; requests that target or
    would clear those states return WORKFLOW_STATUS_REQUIRES_TRANSITION.
  required: [action, selection, payload]
  properties:
    action: { $ref: '#/AssetBulkAction' }
    selection: { $ref: '#/AssetBulkSelection' }
    payload:
      type: object
      description: Action-specific fields; see apps/web/src/lib/validation/asset-bulk.ts.

AssetBulkOperationResult:
  type: object
  description: Every bulk action reports this same processed/succeeded/failed/skipped envelope -- partial failure is always visible.
  required: [processed, succeeded, failed, skipped]
  properties:
    processed: { type: integer, minimum: 0 }
    succeeded: { type: integer, minimum: 0 }
    failed: { type: integer, minimum: 0 }
    skipped: { type: integer, minimum: 0 }
    failures:
      type: array
      items:
        type: object
        required: [assetId, reason]
        properties:
          assetId: { $ref: './common.yaml#/Cuid' }
          reason: { type: string, examples: [not_in_dataset, already_labeled, not_labeled] }

AssetBulkResponse:
  description: >-
    A small selection executes synchronously; a selection exceeding the
    server-enforced maximum (Delete/Export Selected only -- the four organize
    actions return 422 SELECTION_TOO_LARGE instead) runs as a background Job.
  oneOf:
    - type: object
      required: [mode, result]
      properties:
        mode: { type: string, enum: [SYNC] }
        result: { $ref: '#/AssetBulkOperationResult' }
    - type: object
      required: [mode, jobId]
      properties:
        mode: { type: string, enum: [JOB] }
        jobId: { $ref: './common.yaml#/Cuid' }

DatasetMember:
  type: object
  description: Read-only membership row backing the Assign action/filter boundary (FR-004/FR-018) -- no invitation or role-management capability.
  required: [id, name, email, role]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    name: { type: string }
    email: { type: string, format: email }
    role: { type: string, enum: [OWNER, MANAGER, REVIEWER, LABELER] }

DatasetMemberListResponse:
  type: object
  required: [items]
  properties:
    items:
      type: array
      items: { $ref: '#/DatasetMember' }

ExportSelectedDownload:
  type: object
  description: Null until the BULK_EXPORT_SELECTED Job reaches COMPLETED.
  properties:
    download:
      nullable: true
      type: object
      required: [url, expiresAt, filename]
      properties:
        url: { type: string, format: uri, description: Short-lived (5 minute) presigned MinIO GET URL. }
        expiresAt: { $ref: './common.yaml#/Timestamp' }
        filename: { type: string }
</file>

<file path="specs/api/schemas/collaboration.yaml">
