        name: process.env.SEED_ADMIN_NAME?.trim() || "Development Operator",
        role: UserRole.ADMIN,
      },
    });
  }

  if (datasetId) {
    const dataset = await prisma.dataset.findUnique({
      where: { id: datasetId },
      select: { id: true },
    });

    if (!dataset) {
      throw new Error("SEED_DATASET_ID does not identify an existing dataset.");
