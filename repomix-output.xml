<file path="specs/api/schemas/common.yaml">
# Shared schema fragments reused across every tag.
#
# Source of truth: apps/web/src/lib/api-response.ts
#
# Every route in this codebase responds with one of two envelopes:
#   success -> { "data": <payload> }
#   failure -> { "error": { "code": "...", "message": "...", "fieldErrors"?: {...} } }
# There is no bare/untyped response body anywhere in the inventoried routes.

ApiError:
  type: object
  description: >-
    The uniform failure envelope produced by apiError() (apps/web/src/lib/api-response.ts).
    Every documented 4xx/5xx response uses this shape.
  required: [error]
  properties:
    error:
      type: object
      required: [code, message]
      properties:
        code:
          type: string
          description: >-
            Machine-readable error code. Codes are route-specific; see each operation's
            documented responses for the exact codes it can return. Some codes (for example
            GITEA_NOT_FOUND) are reused generically across domains in the current
            implementation rather than renamed per resource -- this schema documents the
            code strings the API actually returns, not an idealized naming scheme.
          examples: [INVALID_REQUEST]
        message:
          type: string
          description: Human-readable, safe-to-display error message.
          examples: ["The request is invalid."]
        fieldErrors:
          type: object
          description: >-
            Optional per-field validation messages, present only on some INVALID_REQUEST
            responses that originate from a Zod safeParse() failure via
            error.flatten().fieldErrors.
          additionalProperties:
            type: array
            items:
              type: string
      additionalProperties: false
  additionalProperties: false

Cuid:
  type: string
  description: >-
    Opaque CUID identifier (Prisma `@default(cuid())`). Not a UUID -- do not validate
    against a UUID pattern.
  examples: [cly3x9f2q0000u8j4h2m5k9p1]

Timestamp:
  type: string
  format: date-time
  description: ISO-8601 timestamp (Prisma DateTime serialized by NextResponse.json).
</file>

<file path="specs/api/schemas/dataset.yaml">
# Dataset domain schemas.
#
# Source of truth:
#   apps/web/src/lib/dataset-metadata.ts        (datasetMetadataSelect)
#   apps/web/src/lib/validation/dataset.ts      (createDatasetSchema, updateDatasetSchema, datasetIdSchema)
#   apps/web/src/app/api/datasets/route.ts
#   apps/web/src/app/api/datasets/[datasetId]/route.ts
#   prisma/schema.prisma (DatasetType, DatasetSourceMode)

DatasetType:
  type: string
  enum: [IMAGE_LABELING, VIDEO_LABELING, TEXT_LABELING, AUDIO_LABELING, MULTI_MODAL]

DatasetSourceMode:
  type: string
  enum: [UPLOAD, MIRROR_TO_MINIO, EXTERNAL_REF, HYBRID_CACHE]

DatasetWorkflowStatus:
  type: string
  enum: [IN_PROGRESS, COMPLETED, REVIEWED]
  description: Write-only convenience field on PATCH; persisted inside the Dataset's metadata JSON rather than as its own column.

Dataset:
  type: object
  description: Safe dataset projection (datasetMetadataSelect). Never includes ownerId, member rows, or source-connection detail.
  required: [id, name, description, type, primaryModality, sourceMode, createdAt, updatedAt, archivedAt]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    name:
      type: string
    description:
      type: [string, "null"]
    type:
      $ref: '#/DatasetType'
    primaryModality:
      oneOf:
        - $ref: './assets.yaml#/Modality'
        - type: "null"
    sourceMode:
      $ref: '#/DatasetSourceMode'
    createdAt:
      $ref: './common.yaml#/Timestamp'
    updatedAt:
      $ref: './common.yaml#/Timestamp'
    archivedAt:
      oneOf:
        - $ref: './common.yaml#/Timestamp'
        - type: "null"
  additionalProperties: false

DatasetListResponse:
  type: object
  description: >-
    Offset-paginated per 021-production-hardening-garbage-collection's
    contracts/pagination-envelope.md. `page`/`pageSize` request query
    parameters are optional (default page 1, default pageSize 20, hard-capped
    at the server's configured PAGINATION_MAX_PAGE_SIZE regardless of what the
    caller requests); the response always includes all four fields below.
  required: [items, page, pageSize, total]
  properties:
    items:
      type: array
      items:
        $ref: '#/Dataset'
    page:
      type: integer
      minimum: 1
      examples: [1]
    pageSize:
      type: integer
      minimum: 1
      examples: [20]
    total:
      type: integer
      minimum: 0
      description: Total matching Dataset count across all pages, not just this page's item count.
      examples: [137]
  additionalProperties: false

CreateDatasetRequest:
  type: object
  description: >-
    Source: createDatasetSchema. Requires the actor to pass canCreateDataset
    (MANAGER or ADMIN role).
  required: [name]
  properties:
    name:
      type: string
      minLength: 2
      maxLength: 120
    description:
      type: string
      maxLength: 2000
    type:
      $ref: '#/DatasetType'
      default: MULTI_MODAL
    primaryModality:
      oneOf:
        - $ref: './assets.yaml#/Modality'
        - type: "null"
    metadata:
      type: object
      description: Free-form JSON object; defaults to {}.
  additionalProperties: false

UpdateDatasetRequest:
  type: object
  description: "Source: updateDatasetSchema. At least one field is required."
  minProperties: 1
  properties:
    name:
      type: string
      minLength: 2
      maxLength: 120
    description:
      type: string
      maxLength: 2000
    type:
      $ref: '#/DatasetType'
    primaryModality:
      oneOf:
        - $ref: './assets.yaml#/Modality'
        - type: "null"
    metadata:
      type: object
      description: When provided, replaces the metadata object except for the workflowStatus key (merged separately when workflowStatus is also present).
    workflowStatus:
      $ref: '#/DatasetWorkflowStatus'
  additionalProperties: false
</file>

<file path="specs/api/schemas/import-repository.yaml">
# Import / Repository domain schemas.
#
# The largest and most security-sensitive domain in the API: creating Datasets
# from an external Git repository (GitHub/Gitea), managing saved Gitea source
# connections, browsing Gitea repositories/trees for the import UI, and the
# local-folder (browser directory) import flow. AGENTS.md's security rules
# apply most directly here -- no provider token, MinIO credential, or private
# repository URL is ever returned to the browser; a one-time PAT is accepted
# only as transient request memory.
#
# Source of truth:
#   apps/web/src/lib/validation/repository-import-request.ts (repositoryImportRequestSchema)
#   apps/web/src/lib/validation/repository-preflight.ts       (repositoryPreflightSchema)
#   apps/web/src/lib/validation/source-connection.ts           (sourceConnectionCreateSchema, sourceImportPreflightSchema)
#   apps/web/src/lib/validation/local-folder-import.ts         (start/append/complete/upload-capabilities schemas)
#   apps/web/src/lib/validation/gitea.ts                       (repository list/tree query schemas)
#   apps/web/src/lib/repository-import/acceptance.ts, types.ts (RepositoryImportAcceptance)
#   apps/web/src/lib/repository-import/../providers/provider.types.ts (PreflightResult)
#   apps/web/src/lib/source-connection-dto.ts                   (SafeSourceConnection)
#   apps/web/src/lib/imports/prepare-local-folder-import.ts, complete-local-folder-item.ts, local-folder-upload.ts
#   apps/web/src/app/api/datasets/from-repository/route.ts
#   apps/web/src/app/api/source-repositories/preflight/route.ts
#   apps/web/src/app/api/source-import-preflight/route.ts
#   apps/web/src/app/api/source-connections/route.ts, [id]/route.ts
#   apps/web/src/app/api/gitea/repos/route.ts, [owner]/[repo]/tree/route.ts
#   apps/web/src/app/api/imports/local-folder/route.ts
#   apps/web/src/app/api/datasets/[datasetId]/imports/local-folder/route.ts
#   apps/web/src/app/api/imports/[preparedImportId]/upload-capabilities/route.ts
#   apps/web/src/app/api/imports/[preparedImportId]/items/[itemId]/complete/route.ts
#   apps/web/src/app/api/gitea/import/route.ts (deprecated, 410)
#   apps/web/src/app/api/source-import-jobs/route.ts (deprecated, 410)

# --- Repository identity / credentials ---------------------------------------

RepositoryProvider:
  type: string
  enum: [GITHUB, GITEA]

RepositoryVisibility:
  type: string
  enum: [PUBLIC, PRIVATE]

CredentialMode:
  type: string
  enum: [PUBLIC, EXISTING_SOURCE_CONNECTION, ONE_TIME_PAT]
  description: >-
    GITHUB imports only ever use PUBLIC. GITEA imports use PUBLIC (server-known
    public Gitea root), EXISTING_SOURCE_CONNECTION (a saved SourceConnection), or
    ONE_TIME_PAT (a token supplied for this request only, retained only in
    server-request memory and never echoed back, logged, or persisted unless
    explicitly saved as a connection).

# --- POST /api/datasets/from-repository --------------------------------------

RepositoryImportRequest:
  type: object
  description: >-
    Source: repositoryImportRequestSchema. The only public durable request that
    creates a new repository-backed Dataset. Field requirements vary by
    provider/credentialMode (see the per-field descriptions); the server
    rejects a combination that supplies credentials it does not expect for the
    chosen mode.
  required: [provider, repository, credentialMode, datasetName, idempotencyKey]
  properties:
    provider:
      $ref: '#/RepositoryProvider'
    repository:
      type: object
      required: [owner, name, ref, expectedVisibility]
      properties:
        owner:
          type: string
          pattern: '^[A-Za-z0-9_.-]+$'
          maxLength: 100
        name:
          type: string
          pattern: '^[A-Za-z0-9_.-]+$'
          maxLength: 100
        repoUrl:
          type: string
          format: uri
          maxLength: 2048
          description: Required for GITHUB; must be the canonical https://github.com/{owner}/{name} URL.
        ref:
          type: string
          maxLength: 255
        rootPath:
          type: string
          maxLength: 1024
        expectedVisibility:
          $ref: '#/RepositoryVisibility'
      additionalProperties: false
    credentialMode:
      $ref: '#/CredentialMode'
    sourceConnectionId:
      type: string
      maxLength: 128
      description: Required (and only meaningful) when credentialMode is EXISTING_SOURCE_CONNECTION.
    serverUrl:
      type: string
      format: uri
      maxLength: 2048
      description: Required for GITEA when credentialMode is PUBLIC or ONE_TIME_PAT.
    personalAccessToken:
      type: string
      maxLength: 4096
      description: Required when credentialMode is ONE_TIME_PAT. Never returned, logged, or persisted unless saveAsSourceConnection is true.
    saveAsSourceConnection:
      type: boolean
      description: Only meaningful with ONE_TIME_PAT.
    connectionName:
      type: string
      maxLength: 80
    datasetName:
      type: string
      minLength: 1
      maxLength: 160
    idempotencyKey:
      type: string
      minLength: 16
      maxLength: 160
      description: Caller-generated key. A replayed key returns the already-accepted result rather than creating a second Dataset/Job.
  additionalProperties: false

RepositoryImportAcceptance:
  type: object
  description: >-
    Returned with 202 on first acceptance, or 200 when idempotencyKey replayed
    an already-accepted request. The Dataset/Job are created together in one
    transaction; import content is populated asynchronously by the private
    worker, not by this request.
  required: [dataset, job, progressPath]
  properties:
    dataset:
      type: object
      required: [id, name]
      properties:
        id: { $ref: './common.yaml#/Cuid' }
        name: { type: string }
      additionalProperties: false
    job:
      type: object
      required: [id, datasetId, type, status]
      properties:
        id: { $ref: './common.yaml#/Cuid' }
        datasetId: { $ref: './common.yaml#/Cuid' }
        type: { type: string, enum: [IMPORT_DATASET] }
        status: { $ref: './jobs.yaml#/JobStatus' }
      additionalProperties: false
    progressPath:
      type: string
      description: App route the browser should poll/navigate to for import progress (a GET /api/jobs/{jobId}-style path).
  additionalProperties: false

# --- POST /api/source-repositories/preflight ---------------------------------

RepositoryPreflightRequest:
  type: object
  description: >-
    Source: repositoryPreflightSchema. Read-only; does not create a Dataset,
    Job, SourceConnection, queue delivery, or storage object.
  required: [provider, repository]
  properties:
    provider:
      $ref: '#/RepositoryProvider'
    repository:
      type: object
      required: [owner, name]
      properties:
        owner: { type: string, maxLength: 100 }
        name: { type: string, maxLength: 100 }
        baseUrl:
          type: string
          format: uri
          maxLength: 2048
          description: GITEA only; server-controlled for GITHUB.
      additionalProperties: false
    ref:
      type: string
      maxLength: 255
    rootPath:
      type: string
      maxLength: 1024
    sourceConnectionId:
      type: string
      maxLength: 128
      description: GITEA only. Deliberately not format-validated -- a malformed id is concealed as the same outcome as an unknown/foreign connection.
  additionalProperties: false

RepositoryPreflightResult:
  type: object
  description: Provider-agnostic preflight result (PreflightResult), wrapped as { preflight }.
  required: [provider, repository, visibility, ref, rootPath, assetPreview]
  properties:
    provider:
      $ref: '#/RepositoryProvider'
    repository:
      type: object
      required: [owner, name]
      properties:
        owner: { type: string }
        name: { type: string }
      additionalProperties: false
    visibility:
      $ref: '#/RepositoryVisibility'
    ref:
      type: object
      required: [requested, resolved, revision]
      properties:
        requested: { type: [string, "null"] }
        resolved: { type: string }
        revision: { type: [string, "null"] }
      additionalProperties: false
    rootPath:
      type: object
      required: [requested, normalized, exists]
      properties:
        requested: { type: [string, "null"] }
        normalized: { type: [string, "null"] }
        exists: { type: boolean }
      additionalProperties: false
    assetPreview:
      type: [object, "null"]
      description: Bounded, transient preview only; never a persisted import manifest.
      required: [detectedAssetCount, detectedBytes, truncated, sample]
      properties:
        detectedAssetCount: { type: integer }
        detectedBytes: { type: integer }
        truncated: { type: boolean }
        sample:
          type: array
          items:
            type: object
            required: [path, size, modality]
            properties:
              path: { type: string }
              size: { type: [integer, "null"] }
              modality: { type: string, enum: [IMAGE, VIDEO, AUDIO, TEXT] }
            additionalProperties: false
      additionalProperties: false
  additionalProperties: false

RepositoryPreflightResponse:
  type: object
  required: [preflight]
  properties:
    preflight:
      $ref: '#/RepositoryPreflightResult'
  additionalProperties: false

# --- POST /api/source-import-preflight ----------------------------------------

SourceImportPreflightRequest:
  type: object
  description: >-
    Source: sourceImportPreflightSchema. GITEA only. Same credentialMode rules
    as RepositoryImportRequest. Read-only preview -- does not create a Dataset,
    Job, or SourceConnection.
  required: [provider, datasetName, repository, credentialMode]
  properties:
    provider:
      type: string
      enum: [GITEA]
    datasetName:
      type: string
      minLength: 1
      maxLength: 160
    repository:
      type: object
      required: [owner, repo, ref, expectedVisibility]
      properties:
        owner: { type: string, maxLength: 160 }
        repo: { type: string, maxLength: 160 }
        ref: { type: string, maxLength: 255 }
        rootPath: { type: string, maxLength: 4096 }
        expectedVisibility: { $ref: '#/RepositoryVisibility' }
      additionalProperties: false
    credentialMode:
      $ref: '#/CredentialMode'
    sourceConnectionId:
      type: string
      maxLength: 128
    serverUrl:
      type: string
      format: uri
      maxLength: 2048
    personalAccessToken:
      type: string
      maxLength: 4096
    saveAsSourceConnection:
      type: boolean
    connectionName:
      type: string
      maxLength: 80
  additionalProperties: false

SourceImportPreflightResponse:
  type: object
  required: [readyForImport, repository, assetPreview, availableRefs, visibility]
  properties:
    readyForImport:
      type: boolean
      description: True when the actual repository visibility matches repository.expectedVisibility.
    repository:
      type: object
      required: [provider, fullName, ref, rootPath, visibility]
      properties:
        provider: { type: string, enum: [GITEA] }
        fullName: { type: string, description: "owner/repo" }
        ref: { type: string }
        rootPath: { type: [string, "null"] }
        visibility: { $ref: '#/RepositoryVisibility' }
      additionalProperties: false
    assetPreview:
      $ref: '#/RepositoryPreflightResult'
      description: Reuses the same bounded preview shape as RepositoryPreflightResult.assetPreview.
    availableRefs:
      type: array
      items:
        type: string
    visibility:
      type: object
      required: [expected, actual, matches]
      properties:
        expected: { $ref: '#/RepositoryVisibility' }
        actual: { $ref: '#/RepositoryVisibility' }
        matches: { type: boolean }
      additionalProperties: false
  additionalProperties: false

# --- Source connections --------------------------------------------------------

SourceConnectionProvider:
  type: string
  enum: [GITEA]
  description: The only provider a saved SourceConnection currently supports (GITHUB import is always PUBLIC/credential-free).

SourceConnectionStatus:
  type: string
  enum: [ACTIVE, EXPIRED, REVOKED, ERROR]

SourceConnection:
  type: object
  description: Safe source-connection projection (SafeSourceConnection). Never includes baseUrl or the encrypted/decrypted token.
  required: [id, provider, name, status, tokenExpiresAt, createdAt, updatedAt]
  properties:
    id: { $ref: './common.yaml#/Cuid' }
    provider: { $ref: '#/SourceConnectionProvider' }
    name:
      type: [string, "null"]
    status: { $ref: '#/SourceConnectionStatus' }
    tokenExpiresAt:
      oneOf:
        - $ref: './common.yaml#/Timestamp'
        - type: "null"
    createdAt: { $ref: './common.yaml#/Timestamp' }
    updatedAt: { $ref: './common.yaml#/Timestamp' }
  additionalProperties: false

SourceConnectionListResponse:
  type: object
  description: >-
    Offset-paginated per 021-production-hardening-garbage-collection's
    contracts/pagination-envelope.md. `page`/`pageSize` request query
    parameters are optional; default pageSize is a generous 100 (a user's
    saved source-connection list is small).
  required: [connections, page, pageSize, total]
  properties:
    connections:
      type: array
      items: { $ref: '#/SourceConnection' }
    page:
      type: integer
      minimum: 1
      examples: [1]
    pageSize:
      type: integer
      minimum: 1
      examples: [100]
    total:
      type: integer
      minimum: 0
      examples: [3]
  additionalProperties: false

CreateSourceConnectionRequest:
  type: object
  description: "Source: sourceConnectionCreateSchema. baseUrl and token are write-only -- never echoed back in the response."
  required: [provider, baseUrl, token]
  properties:
    provider:
      type: string
      enum: [GITEA]
    name:
      type: string
      maxLength: 80
    baseUrl:
      type: string
      maxLength: 2048
    token:
      type: string
      maxLength: 4096
  additionalProperties: false

CreateSourceConnectionResponse:
  type: object
  required: [connection]
  properties:
    connection: { $ref: '#/SourceConnection' }
  additionalProperties: false

GetSourceConnectionResponse:
  type: object
  required: [connection]
  properties:
    connection: { $ref: '#/SourceConnection' }
  additionalProperties: false

# --- Gitea repository browsing (used by the import UI) ------------------------

GiteaRepositorySummary:
  type: object
  description: Passed through from the Gitea provider client; shape is provider-defined and not independently re-validated field-by-field here.
  additionalProperties: true

GiteaRepositoryListResponse:
  type: object
  required: [items, pagination]
  properties:
    items:
      type: array
      items: { $ref: '#/GiteaRepositorySummary' }
    pagination:
      type: object
      required: [page, limit, totalCount]
      properties:
        page: { type: integer }
        limit: { type: integer }
        totalCount: { type: integer }
      additionalProperties: false
  additionalProperties: false

GiteaTreeEntry:
  type: object
  description: Provider-defined tree entry shape, filtered server-side to the requested rootPath.
  additionalProperties: true

GiteaRepositoryTreeResponse:
  type: object
  required: [repository, sha, truncated, entries]
  properties:
    repository:
      type: object
      required: [owner, name, ref, rootPath]
      properties:
        owner: { type: string }
        name: { type: string }
        ref: { type: string }
        rootPath: { type: [string, "null"] }
      additionalProperties: false
    sha:
      type: string
    truncated:
      type: boolean
    entries:
      type: array
      items: { $ref: '#/GiteaTreeEntry' }
  additionalProperties: false

# --- Local-folder (browser directory) import -----------------------------------

LocalFolderManifestItem:
  type: object
  description: 'Source: localFolderManifestItemSchema. logicalPath must be relative (no leading slash, no drive letter, no ".." segment) and unique (case-insensitive) within the manifest.'
  required: [logicalPath, contentType, sizeBytes, fingerprint]
  properties:
    logicalPath:
      type: string
      minLength: 1
      maxLength: 1024
    contentType:
      type: string
      enum: [image/png, image/jpeg, image/webp, video/mp4, video/webm, text/plain, text/csv, application/json, audio/wav, audio/mpeg, audio/ogg]
    sizeBytes:
      type: integer
      minimum: 1
      maximum: 104857600
    fingerprint:
      type: string
      pattern: '^[a-f0-9]{64}$'
      description: SHA-256 hex digest.
  additionalProperties: false

StartLocalFolderImportRequest:
  type: object
  description: "Source: startLocalFolderImportSchema. Creates a new Dataset."
  required: [idempotencyKey, items, name]
  properties:
    idempotencyKey:
      type: string
      minLength: 16
      maxLength: 160
    items:
      type: array
      items: { $ref: '#/LocalFolderManifestItem' }
      minItems: 1
      maxItems: 1000
    name:
      type: string
      minLength: 1
      maxLength: 160
    description:
      type: string
      maxLength: 2000
  additionalProperties: false

AppendLocalFolderImportRequest:
  type: object
  description: "Source: appendLocalFolderImportSchema. Appends into the Dataset selected by the path -- name/description are not accepted here."
  required: [idempotencyKey, items]
  properties:
    idempotencyKey:
      type: string
      minLength: 16
      maxLength: 160
    items:
      type: array
      items: { $ref: '#/LocalFolderManifestItem' }
      minItems: 1
      maxItems: 1000
  additionalProperties: false

LocalFolderImportPreparation:
  type: object
  required: [id, datasetId, jobId, expectedItemCount, deadlineAt, items]
  properties:
    id:
      type: string
      description: Prepared-import id (a UUID generated before persistence, not a CUID).
    datasetId: { $ref: './common.yaml#/Cuid' }
    jobId: { $ref: './common.yaml#/Cuid' }
    expectedItemCount: { type: integer }
    deadlineAt: { $ref: './common.yaml#/Timestamp' }
    items:
      type: array
      items:
        type: object
        required: [id]
        properties:
          id: { type: string }
        additionalProperties: false
  additionalProperties: false

StartOrAppendLocalFolderImportResponse:
  type: object
  required: [preparation, replayed, deliveryPending]
  properties:
    preparation: { $ref: '#/LocalFolderImportPreparation' }
    replayed:
      type: boolean
      description: True when idempotencyKey matched an existing preparation instead of creating a new one.
    deliveryPending:
      type: boolean
  additionalProperties: false

UploadCapabilitiesRequest:
  type: object
  description: "Source: uploadCapabilitiesSchema."
  required: [itemIds]
  properties:
    itemIds:
      type: array
      items: { type: string, minLength: 1 }
      minItems: 1
      maxItems: 100
  additionalProperties: false

LocalFolderUploadCapability:
  type: object
  description: Per-item presigned POST upload, structurally identical to PresignedUploadResponse plus itemId.
  required: [itemId, uploadUrl, method, formFields, fileId, expiresInSeconds]
  properties:
    itemId:
      type: string
    uploadUrl:
      type: string
      format: uri
    method:
      type: string
      enum: [POST]
    formFields:
      type: object
      additionalProperties:
        type: string
    fileId:
      type: string
    expiresInSeconds:
      type: integer
  additionalProperties: false

UploadCapabilitiesResponse:
  type: object
  required: [capabilities]
  properties:
    capabilities:
      type: array
      items: { $ref: '#/LocalFolderUploadCapability' }
  additionalProperties: false

CompleteLocalFolderItemRequest:
  type: object
  description: "Source: completeLocalFolderItemSchema."
  required: [fileId]
  properties:
    fileId:
      type: string
      minLength: 32
      maxLength: 8192
  additionalProperties: false

CompleteLocalFolderItemResponse:
  type: object
  required: [assetId, replayed, completed, total]
  properties:
    assetId: { $ref: './common.yaml#/Cuid' }
    replayed:
      type: boolean
    completed:
      type: integer
    total:
      type: integer
  additionalProperties: false
</file>

<file path="specs/api/schemas/jobs.yaml">
# Jobs domain schemas.
#
# A common PostgreSQL Job is the source of truth for every asynchronous workflow
# (AGENTS.md). Export is documented here, not under a separate tag, because
# POST /api/export and GET /api/export/{jobId} create/read a Job of type
# EXPORT_DATASET through the same safe Job projection as every other route below.
#
# Source of truth:
#   apps/web/src/lib/jobs/safe-job-status.ts   (SafeJobStatus / toSafeJobStatus)
#   apps/web/src/lib/jobs/safe-job-event.ts    (SafeJobEvent, browser-safe message/reason vocab)
#   apps/web/src/lib/jobs/safe-job-stage.ts    (SafeJobStage)
#   apps/web/src/lib/jobs/authorization.ts     (readAuthorizedJob, cancelAuthorizedJob)
#   apps/web/src/lib/jobs/retry-job.ts         (retryAuthorizedJob)
#   apps/web/src/lib/imports/commit-local-folder-import.ts
#   apps/web/src/lib/exports/export-service.ts, export-download.ts
#   apps/web/src/lib/validation/export.ts, job.ts
#   prisma/schema.prisma (JobType, JobStatus, JobStage)

JobType:
  type: string
  enum:
    - CLONE_REPOSITORY
    - IMPORT_DATASET
    - SYNC_REPOSITORY
    - EXPORT_DATASET
    - GENERATE_THUMBNAILS
    - EXTRACT_VIDEO_METADATA
    - EXTRACT_VIDEO_FRAMES
    - GENERATE_AUDIO_WAVEFORM
    - AUTO_TRANSCRIBE_AUDIO
    - AUTO_LABEL_DATASET
    - AI_PREANNOTATE_ASSET
    - AI_PREANNOTATE_DATASET
    - AI_TASK_SYNC

JobStatus:
  type: string
  enum: [QUEUED, RUNNING, RETRYING, COMPLETED, FAILED, CANCELING, CANCELED]

JobStage:
  type: [string, "null"]
  description: >-
    Safe stage projection (SafeJobStage, apps/web/src/lib/jobs/safe-job-stage.ts).
    This is NOT the raw Prisma JobStage enum (which has 27 fine-grained internal
    values such as CLONING_REPOSITORY, MAPPING_LABELS, GENERATING_WAVEFORM,
    CREATING_AI_TASK, EXPORTING_DATASET, etc.) -- toSafeJobStage collapses every
    persisted stage down to this fixed 8-value browser vocabulary (e.g.
    SCANNING_FILES/PARSING_IMPORT_FILE/VALIDATING_IMPORT_ROWS all become
    SCANNING; most stages without an explicit mapping, including every AI/export
    stage, collapse to FINALIZING). null only when no Job.stage is persisted yet.
  enum:
    - WAITING
    - VALIDATING_INPUT
    - SCANNING
    - FILTERING
    - UPLOADING_OBJECTS
    - WRITING_ASSETS
    - FINALIZING
    - FINISHED

JobSafeSummary:
  type: [object, "null"]
  description: >-
    Small, strict summary schema (safeJobSummarySchema). Raw Job.summary JSON is
    never returned as-is; an invalid/unrecognized shape sanitizes to null rather
    than partially leaking fields.
  properties:
    message:
      type: string
      maxLength: 280
    outcome:
      type: string
      enum: [completed, failed, canceled]
    completedAt:
      type: string
      format: date-time
    resultCount:
      type: integer
      minimum: 0
    imported:
      type: integer
      minimum: 0
    skipped:
      type: integer
      minimum: 0
    failed:
      type: integer
      minimum: 0
  additionalProperties: false

Job:
  type: object
  description: Safe Job projection (SafeJobStatus). Never includes queue transport fields, lock/lease data, or raw provider error detail.
  required: [id, jobId, datasetId, type, status, stage, progress, totalItems, processedItems, successCount, failedCount, skippedCount, summary, errorCode, errorMessage, createdAt, startedAt, finishedAt, updatedAt]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    jobId:
      $ref: './common.yaml#/Cuid'
      description: Identical to id; kept for client convenience.
    datasetId:
      $ref: './common.yaml#/Cuid'
    type:
      $ref: '#/JobType'
    status:
      $ref: '#/JobStatus'
    stage:
      $ref: '#/JobStage'
    progress:
      type: [integer, "null"]
    totalItems:
      type: [integer, "null"]
    processedItems:
      type: [integer, "null"]
    successCount:
      type: [integer, "null"]
    failedCount:
      type: [integer, "null"]
    skippedCount:
      type: [integer, "null"]
    summary:
      $ref: '#/JobSafeSummary'
    errorCode:
      type: [string, "null"]
      description: Only a small allowlisted set of codes is ever surfaced (see errorMessage); other internal codes are suppressed to both null.
    errorMessage:
      type: [string, "null"]
    createdAt:
      $ref: './common.yaml#/Timestamp'
    startedAt:
      oneOf:
        - $ref: './common.yaml#/Timestamp'
        - type: "null"
    finishedAt:
      oneOf:
        - $ref: './common.yaml#/Timestamp'
        - type: "null"
    updatedAt:
      $ref: './common.yaml#/Timestamp'
  additionalProperties: false

JobEventLevel:
  type: string
  description: Prisma JobEventLevel.

JobEvent:
  type: object
  description: Safe Job operational history entry (SafeJobEvent). Raw JobEvent.data never leaves the server.
  required: [id, createdAt, level, stage, message, reason]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    createdAt:
      $ref: './common.yaml#/Timestamp'
    level:
      $ref: '#/JobEventLevel'
    stage:
      $ref: '#/JobStage'
    message:
      type: string
      description: One of a fixed, browser-safe message vocabulary; an unrecognized persisted message is omitted entirely rather than surfaced.
      enum: [QUEUE_ENQUEUED, QUEUE_DELIVERY_PENDING, QUEUE_RECEIVED, QUEUE_SKIPPED, JOB_CLAIMED, JOB_HEARTBEAT, JOB_PROGRESS, IMPORT_BATCH_COMPLETED, JOB_COMPLETED, JOB_FAILED, JOB_CANCELED, CANCEL_REQUESTED, IMPORT_INCOMPLETE, IMPORT_COMMITTED, JOB_RECOVERED, JOB_DEAD_LETTERED]
    reason:
      type: [string, "null"]
      enum: [MALFORMED_PAYLOAD, UNKNOWN_JOB, NOT_QUEUED, CANCELED, INACTIVE_DATASET, UNSUPPORTED_TYPE, TRANSPORT_CONFLICT, QUEUE_UNAVAILABLE, IMPORT_INCOMPLETE, IMPORT_COMMIT_TIMEOUT, LEASE_EXPIRED, MAX_RUNTIME_EXCEEDED, RECOVERY_EXHAUSTED]
  additionalProperties: false

JobEventPage:
  type: object
  required: [events, nextCursor]
  properties:
    events:
      type: array
      items:
        $ref: '#/JobEvent'
      description: Newest-first.
    nextCursor:
      type: [string, "null"]
      description: Opaque base64url cursor; null when no further page exists.
  additionalProperties: false

CancelJobResponse:
  type: object
  required: [id, status]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    status:
      type: string
      description: Cancellation status returned by cancelAuthorizedJob (a JobStatus value, typically CANCELING or CANCELED).
  additionalProperties: false

RetryJobResponse:
  type: object
  required: [id, datasetId, type, status]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    datasetId:
      $ref: './common.yaml#/Cuid'
    type:
      $ref: '#/JobType'
    status:
      $ref: '#/JobStatus'
  additionalProperties: false

CommitImportJobResponse:
  type: object
  required: [id, status, replayed, completed, total]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    status:
      type: string
      enum: [COMPLETED]
    replayed:
      type: boolean
    completed:
      type: integer
    total:
      type: integer
  additionalProperties: false

# --- Export (a Job of type EXPORT_DATASET) -----------------------------------

ExportRequest:
  type: object
  description: >-
    Source: exportRequestSchema. Phase 012 intentionally supports one bounded,
    metadata-only export format.
  required: [datasetId]
  properties:
    datasetId:
      $ref: './common.yaml#/Cuid'
    format:
      type: string
      enum: [JSON]
      default: JSON
    manifestSchemaVersion:
      type: string
      enum: ["1"]
      default: "1"
  additionalProperties: false

ExportJob:
  description: A Job (see the Job schema) narrowed to type EXPORT_DATASET.
  allOf:
    - $ref: '#/Job'
    - type: object
      properties:
        type:
          type: string
          enum: [EXPORT_DATASET]

CreateExportResponse:
  type: object
  required: [job, deliveryPending]
  properties:
    job:
      $ref: '#/ExportJob'
    deliveryPending:
      type: boolean
      description: True when the Job committed to PostgreSQL but its BullMQ enqueue has not yet been confirmed delivered.
  additionalProperties: false

ExportDownload:
  type: [object, "null"]
  description: Null when the export Job has not yet reached COMPLETED.
  required: [url, expiresAt, filename]
  properties:
    url:
      type: string
      format: uri
      description: Short-lived, object-scoped MinIO presigned GET URL for the export artifact.
    expiresAt:
      $ref: './common.yaml#/Timestamp'
    filename:
      type: string
  additionalProperties: false

GetExportResponse:
  type: object
  required: [job, download]
  properties:
    job:
      $ref: '#/ExportJob'
    download:
      $ref: '#/ExportDownload'
  additionalProperties: false
</file>

<file path="specs/api/schemas/labels.yaml">
# Labels domain schemas.
#
# Source of truth:
#   apps/web/src/lib/dataset-metadata.ts        (labelMetadataSelect)
#   apps/web/src/lib/validation/label.ts        (labelMutationSchema, labelIdSchema)
#   apps/web/src/lib/workspace/label-management.ts (deleteUnreferencedLabel)
#   apps/web/src/app/api/datasets/[datasetId]/labels/route.ts
#   apps/web/src/app/api/labels/[labelId]/route.ts
#   prisma/schema.prisma (LabelScope, Label model)

LabelScope:
  type: string
  enum: [OBJECT, SEGMENTATION, KEYPOINT, CLASSIFICATION, ACTION, EVENT, SCENE, ENTITY]
  description: Not settable through this API today -- always OBJECT (the Prisma column default) for every label created via POST .../labels.

Label:
  type: object
  description: Safe label projection (labelMetadataSelect).
  required: [id, datasetId, modality, scope, name, normalizedName, color, description, hotkey, createdAt, updatedAt]
  properties:
    id:
      $ref: './common.yaml#/Cuid'
    datasetId:
      $ref: './common.yaml#/Cuid'
    modality:
      description: Null when the label applies across every modality in the dataset.
      oneOf:
        - $ref: './assets.yaml#/Modality'
        - type: "null"
    scope:
      $ref: '#/LabelScope'
    name:
      type: string
    normalizedName:
      type: string
      description: Lowercased form used for the dataset-scoped uniqueness constraint.
    color:
      type: string
      pattern: '^#[0-9A-F]{6}$'
    description:
      type: [string, "null"]
      description: Persisted as null, not empty string, when the create/update request supplied an empty description ("" is normalized to null on write).
    hotkey:
      type: [string, "null"]
      description: Persisted as null, not empty string, when the create/update request supplied an empty hotkey ("" is normalized to null on write).
    createdAt:
      $ref: './common.yaml#/Timestamp'
    updatedAt:
      $ref: './common.yaml#/Timestamp'
  additionalProperties: false

LabelListResponse:
  type: object
  description: >-
    Offset-paginated per 021-production-hardening-garbage-collection's
    contracts/pagination-envelope.md. `page`/`pageSize` request query
    parameters are optional; default pageSize is a generous 100 (a dataset's
    label taxonomy is a small reference set, not a browseable list) so an
    unparameterized request keeps returning the full taxonomy unless a
    dataset genuinely exceeds that many labels.
  required: [items, page, pageSize, total]
  properties:
    items:
      type: array
      items:
        $ref: '#/Label'
    page:
      type: integer
      minimum: 1
      examples: [1]
    pageSize:
      type: integer
      minimum: 1
      examples: [100]
    total:
      type: integer
      minimum: 0
      examples: [12]
  additionalProperties: false

LabelMutationRequest:
  type: object
  description: "Source: labelMutationSchema. Shared by POST (create) and PATCH (update)."
  required: [name, color]
  properties:
    name:
      type: string
      minLength: 2
      maxLength: 50
    color:
      type: string
      pattern: '^#[0-9A-Fa-f]{6}$'
      description: Normalized to uppercase server-side.
    description:
      type: string
      maxLength: 280
      default: ""
    hotkey:
      type: string
      description: Must be empty or exactly one letter/number; normalized to uppercase.
      default: ""
  additionalProperties: false
</file>

<file path="specs/api/schemas/media.yaml">
# Media domain schemas.
#
# Covers scheduling/reading VIDEO and AUDIO media-processing Jobs, and the
# narrow IMAGE dimensions backfill endpoint. Does not cover the VIDEO annotation
# read/write surface (tracks/keyframes/temporal labels) -- that is Annotation
# data and is documented under the Annotations tag.
#
# Source of truth:
#   apps/web/src/lib/media-processing/ensure-media-processing-job.ts
#   apps/web/src/lib/media-processing/contracts.ts   (mediaProcessingRequestSchema, job types)
#   apps/web/src/types/media-processing.ts           (SafeMediaReadiness)
#   apps/web/src/app/api/assets/[assetId]/media-processing/route.ts
#   apps/web/src/app/api/assets/[assetId]/media-processing/status/route.ts
#   apps/web/src/app/api/images/[imageId]/dimensions/route.ts

MediaProcessingJobType:
  type: string
  enum: [EXTRACT_VIDEO_METADATA, GENERATE_AUDIO_WAVEFORM]
  description: >-
    The two media-processing job types reachable through this route today.
    GENERATE_THUMBNAILS/EXTRACT_VIDEO_FRAMES/AUTO_TRANSCRIBE_AUDIO exist as
    JobType values but are not accepted by this request schema.

ScheduleMediaProcessingRequest:
  type: object
  description: "Source: mediaProcessingRequestSchema. assetId itself comes from the path, not the body."
  required: [type]
  properties:
    type:
      $ref: '#/MediaProcessingJobType'
  additionalProperties: false

ScheduleMediaProcessingResponse:
  type: object
  required: [jobId, status, deliveryPending, reused]
  properties:
    jobId:
      $ref: './common.yaml#/Cuid'
    status:
      type: string
      description: Prisma JobStatus of the (possibly reused) media-processing Job.
    deliveryPending:
      type: boolean
      description: True when the Job committed to PostgreSQL but its BullMQ enqueue has not yet been confirmed delivered.
    reused:
      type: boolean
      description: True when an existing Job for this asset+type+source-fingerprint was reused instead of creating a new one.
  additionalProperties: false

MediaReadinessState:
  type: string
  enum: [NOT_REQUESTED, QUEUED, RUNNING, RETRYING, COMPLETED, FAILED, CANCELING, CANCELED]

MediaReadiness:
  type: object
  description: Safe media-processing readiness projection (SafeMediaReadiness). Only VIDEO/AUDIO assets are meaningful callers.
  required: [assetId, modality, state, stage, progress, counters, outcome]
  properties:
    assetId:
      $ref: './common.yaml#/Cuid'
    modality:
      type: string
      enum: [VIDEO, AUDIO]
    state:
      $ref: '#/MediaReadinessState'
    stage:
      $ref: './jobs.yaml#/JobStage'
    progress:
      type: [integer, "null"]
    counters:
      type: object
      required: [total, processed, succeeded, failed, skipped]
      properties:
        total: { type: [integer, "null"] }
        processed: { type: [integer, "null"] }
        succeeded: { type: [integer, "null"] }
        failed: { type: [integer, "null"] }
        skipped: { type: [integer, "null"] }
      additionalProperties: false
    outcome:
      type: [object, "null"]
      required: [code, message]
      properties:
        code: { type: [string, "null"] }
        message: { type: [string, "null"] }
      additionalProperties: false
    video:
      type: object
      properties:
        durationMs: { type: [integer, "null"] }
        fps: { type: [number, "null"] }
        totalFrames: { type: [integer, "null"] }
        codec: { type: [string, "null"] }
      additionalProperties: false
    audio:
      type: object
      properties:
        durationMs: { type: [integer, "null"] }
        sampleRate: { type: [integer, "null"] }
        channels: { type: [integer, "null"] }
        codec: { type: [string, "null"] }
        bitRate: { type: [integer, "null"] }
        waveformReady: { type: boolean }
      additionalProperties: false
  additionalProperties: false

SetImageDimensionsRequest:
  type: object
  description: "Source: dimensionsSchema (inline in the route). Rejected once width/height are already set (see path description)."
  required: [width, height]
  properties:
    width:
      type: integer
      minimum: 1
      maximum: 100000
    height:
      type: integer
      minimum: 1
      maximum: 100000
  additionalProperties: false

SetImageDimensionsResponse:
  type: object
  required: [updated, dimensions]
  properties:
    updated:
      type: boolean
      description: False when the asset's width/height were already set (the update matched zero rows) -- this is not reported as an error.
    dimensions:
      type: object
      required: [width, height]
      properties:
        width: { type: integer }
        height: { type: integer }
      additionalProperties: false
  additionalProperties: false
</file>

