  -v "$PWD:/workspace" -v /workspace/node_modules \
  -v /workspace/apps/web/node_modules \
  --entrypoint sh worker \
  -lc 'cd /workspace && pnpm --filter @annotationplatform/web test:dataset-metadata'
```

