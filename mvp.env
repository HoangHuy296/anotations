# PostgreSQL connection used by Prisma.
# Server-only Gitea integration. Never prefix these with NEXT_PUBLIC_.
GITEA_ACCESS_TOKEN="replace-with-a-server-side-token"

# Reverse-proxy identity header read by the application.
AUTH_EMAIL_HEADER="x-auth-request-email"
AUTH_PROXY_SECRET_HEADER="x-fieldframe-proxy-secret"
AUTH_PROXY_SECRET="replace-with-a-long-random-shared-secret"

# Development-only identity. Seed the same address as an administrator.
# DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=
