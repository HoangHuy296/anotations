# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.review.example

# local application storage
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace and containers
apps/*/.next/
apps/*/dist/
packages/*/dist/
.pnpm-store/
compose.override.yaml
docker-data/

# local sync scratch space (scripts/sync-dev-to-review.sh)
/tmp/

# generated OpenAPI bundle + standalone Swagger UI docs page
# (pnpm docs:build -> scripts/bundle-openapi.py + scripts/generate-swagger-ui.mjs)
/specs/api/dist/
