# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.review.example

# local application storage
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace and containers
apps/*/.next/
apps/*/dist/
packages/*/dist/
.pnpm-store/
compose.override.yaml
docker-data/

# local sync scratch space (scripts/sync-dev-to-review.sh)
/tmp/

# generated OpenAPI bundle + standalone Swagger UI docs page
# (pnpm docs:build -> scripts/bundle-openapi.py + scripts/generate-swagger-ui.mjs)
/specs/api/dist/

# Generated repository text exports; source files remain authoritative.
/repomix-output.*

# Phase 029 generated verification evidence (kept locally; see cleanup review).
# Keep Markdown reports, test/source files and SQL visible to Git.
/specs/029-modality-specific-datasets/verification/**/*.log
/specs/029-modality-specific-datasets/verification/**/*.json
/specs/029-modality-specific-datasets/verification/**/*.gz
/specs/029-modality-specific-datasets/verification/**/*.diff
/specs/029-modality-specific-datasets/verification/**/*.txt
/specs/029-modality-specific-datasets/verification/**/*.before

# Phase 029 verification: raw run evidence stays local (archived under .data/cleanup-archives, see ARCHIVE-INDEX.md).
/specs/029-modality-specific-datasets/verification/*
!/specs/029-modality-specific-datasets/verification/ARCHIVE-INDEX.md
!/specs/029-modality-specific-datasets/verification/mvp-modality-card-status-20261005.md

# Python bytecode
__pycache__/
*.pyc
