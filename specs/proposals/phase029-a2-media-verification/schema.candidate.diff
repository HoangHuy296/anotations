+
+enum MediaVerificationSource {
+  DIRECT_UPLOAD
+  LOCAL_FOLDER_ITEM
+}
+
+enum MediaVerificationStatus {
+  PENDING
+  SEALED
+  VERIFIED
+  PUBLISHED
+  REJECTED
+  STALE
+  CANCELED
+  EXPIRED
+}
+
+/// A2 durable pre-publication media verification (frozen contract: specs/029-modality-specific-datasets/contracts/premedia-verification-a2.md section 4).
+model MediaVerification {
+  id                   String                  @id @default(uuid())
+  datasetId            String
+  requestedById        String
+  source               MediaVerificationSource
+  preparedImportItemId String?
+  currentJobId         String?
+  generation           Int                     @default(1)
+  boundDatasetModality Modality
+
+  stagedBucket       String
+  stagedKey          String
+  stagedEtag         String
+  stagedSizeBytes    BigInt
+  stagedLastModified DateTime
+  stagedVersionId    String?
+
+  filename            String
+  relativePathHint    String?
+  declaredContentType String
+  declaredSizeBytes   BigInt
+
+  sealedKey          String?   @unique
+  sealedEtag         String?
+  sealedSizeBytes    BigInt?
+  sealedLastModified DateTime?
+  sealedVersionId    String?
+  contentSha256      String?
+
+  status                 MediaVerificationStatus @default(PENDING)
+  verifiedModality       Modality?
+  resultCode             String?
+  resultReason           String?
+  probe                  Json?
+  policyVersion          String?
+  processorVersion       String?
+  lastFailureCode        String?
+  lastFailureReason      String?
+  lastFailureAt          DateTime?
+  objectsClearedAt       DateTime?
+  assetId                String?                 @unique
+  verificationDeadlineAt DateTime
+  sealedAt               DateTime?
+  verifiedAt             DateTime?
+  publishedAt            DateTime?
+  finishedAt             DateTime?
+  createdAt              DateTime                @default(now())
+  updatedAt              DateTime                @updatedAt
+
+  dataset            Dataset             @relation(fields: [datasetId], references: [id], onDelete: Cascade)
+  requestedBy        User                @relation("MediaVerificationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
+  preparedImportItem PreparedImportItem? @relation(fields: [preparedImportItemId], references: [id], onDelete: Cascade)
+  currentJob         Job?                @relation("MediaVerificationCurrentJob", fields: [currentJobId], references: [id], onDelete: SetNull)
+  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
+
+  @@unique([stagedBucket, stagedKey, generation])
+  @@unique([preparedImportItemId, generation])
+  @@index([status, verificationDeadlineAt])
+  @@index([requestedById, status])
+  @@index([datasetId, status])
+  @@index([currentJobId])
+}
