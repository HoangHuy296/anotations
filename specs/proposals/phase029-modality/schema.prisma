model DatasetSnapshot {
  id              String                  @id
  datasetId       String
  generation      BigInt
  contentDigest   String
  algorithm       String
  ordinal         Int
  assetCount      Int
  annotationCount Int
  publishedAt     DateTime                @default(now())
  dataset         Dataset                 @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  artifacts       VisualizationArtifact[]

  @@unique([id, datasetId])
  @@unique([datasetId, ordinal])
  @@index([datasetId, generation])
}

model VisualizationArtifact {
  id          String          @id
  datasetId   String
  snapshotId  String
  kind        String
  algorithm   String
  scope       String
  bucket      String
  key         String
  sha256      String
  sizeBytes   BigInt
  contentType String
  publishedAt DateTime        @default(now())
  dataset     Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  snapshot    DatasetSnapshot @relation(fields: [snapshotId, datasetId], references: [id, datasetId], onDelete: Cascade)

  @@unique([bucket, key])
  @@unique([datasetId, snapshotId, kind, algorithm, scope])
  @@index([datasetId, snapshotId])
}
