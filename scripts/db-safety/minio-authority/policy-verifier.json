{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSealedAndStaging",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/verified-uploads/*",
        "arn:aws:s3:::__BUCKET__/direct-uploads/*",
        "arn:aws:s3:::__BUCKET__/prepared-imports/*"
      ]
    },
    {
      "Sid": "BucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__"
      ]
    },
    {
      "Sid": "SealedOwner",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/verified-uploads/*"
      ]
    },
    {
      "Sid": "StagingCleanup",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/direct-uploads/*",
        "arn:aws:s3:::__BUCKET__/prepared-imports/*"
      ]
    },
    {
      "Sid": "DenyStagingWrite",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:PutObjectTagging",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/direct-uploads/*",
        "arn:aws:s3:::__BUCKET__/prepared-imports/*"
      ]
    }
  ]
}
